---
import '@fontsource/amiri/arabic-400.css';
import '@fontsource/katibeh/arabic-400.css';
import '@fontsource/tajawal/arabic-400.css';
import '@fontsource/tajawal/arabic-500.css';
import '@fontsource/tajawal/arabic-700.css';
import '../styles/global.css';
import amiriRegular from '@fontsource/amiri/files/amiri-arabic-400-normal.woff2?url';
import katibeh from '@fontsource/katibeh/files/katibeh-arabic-400-normal.woff2?url';
import Icons from '../components/Icons.astro';
import NavLink from '../components/NavLink.astro';
// TEMPORARY font lab
import FontLab from '../components/FontLab.astro';
import { SITE_NAME, volumeSizes } from '../lib/diwan';
import { mainMenu, toolsMenu, mobileMenu, sections } from '../lib/nav';
import type { SectionKey } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  /** Structured data (schema.org) for this page. */
  jsonLd?: object;
  type?: 'website' | 'article';
  /** Which nav item to mark as current. */
  section?: SectionKey;
  /** On poem pages: shown in the top bar once the reader scrolls past the title. */
  reading?: { title: string; total: number };
  /** Keep the page out of search engines (e.g. the personal saved list). */
  noindex?: boolean;
}

const { title, description, jsonLd, type = 'website', section, reading, noindex } = Astro.props;
// Test deployments are built with NOINDEX=1 so search engines skip them; the final site leaves it unset.
const hideFromSearch = noindex || process.env.NOINDEX === '1';
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/share.png', Astro.site);
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- TEMPORARY font lab: early saved-choice restoration -->
    <FontLab head />
    <title>{title}</title>
    <meta name="description" content={description} />
    {hideFromSearch && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={amiriRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={katibeh} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#eaf0f7" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Apply saved theme and reading settings before the page paints (no flash).
      (function () {
        var root = document.documentElement, t = null, r = null;
        try {
          t = localStorage.getItem('radi-theme');
          r = JSON.parse(localStorage.getItem('radi-reading') || 'null');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.dataset.theme = t;
        if (r) {
          if (r.scale) root.style.setProperty('--poem-scale', r.scale);
          if (r.layout) root.dataset.verseLayout = r.layout;
        }
      })();
    </script>
  </head>
  <body>
    <Icons />
    <a class="skip" href="#main">انتقل إلى المحتوى</a>
    <div class="shell">
      <aside class="sidebar" aria-label="القائمة الرئيسية">
        <a class="brand" href="/" aria-label="الرَّضي، الرئيسية">
          <span class="brand-name">الرَّضِي</span>
          <span>ديوان الشريف الرضي</span>
          <small>القصائد والفهارس</small>
        </a>
        <div class="sidebar-rule" aria-hidden="true">✦</div>
        <div class="sidebar-label">الأقسام</div>
        <nav class="menu" aria-label="أقسام الديوان">
          {mainMenu.map((item) => <NavLink item={item} current={section} />)}
        </nav>
        <div class="sidebar-label">فهارس وأدوات</div>
        <nav class="menu" aria-label="أدوات المعرفة">
          {toolsMenu.map((item) => <NavLink item={item} current={section} />)}
          <!-- TEMPORARY font lab -->
          <button type="button" data-fontlab-open aria-controls="fontLab" aria-expanded="false" aria-haspopup="dialog">
            <svg class="ui-icon" aria-hidden="true"><path d="M4 5h16M12 5v14M8 19h8" /></svg>
            مختبر الخطوط
          </button>
        </nav>
        <div class="sidebar-bottom">
          <div class="sidebar-verse">«ليهنك اليوم أنّ القلب مرعاك»</div>
          <span>نصّ الديوان وفهارسه</span>
        </div>
      </aside>

      <header class="topbar" id="topbar">
        <div class="topbar-inner">
          <a class="top-brand" href="/" aria-label="الرَّضي، الرئيسية">الرَّضِي</a>
          <div class="breadcrumb"><span class="breadcrumb-dot"></span><span>{SITE_NAME}</span></div>
          {
            reading && (
              <div class="reading-status" id="readingStatus" aria-hidden="true">
                <b>{reading.title}</b>
                <span data-reading-pos>البيت ١ من {reading.total}</span>
              </div>
            )
          }
          <div class="top-actions">
            <!-- TEMPORARY font lab: also reachable on phones -->
            <button class="iconbtn" type="button" data-fontlab-open aria-controls="fontLab" aria-expanded="false"
              aria-haspopup="dialog" aria-label="مختبر الخطوط (تجريبي)" title="مختبر الخطوط (تجريبي)">
              <svg class="ui-icon" aria-hidden="true"><path d="M4 5h16M12 5v14M8 19h8" /></svg>
            </button>
            {
              sections.search.href && (
                <a class="iconbtn" href={sections.search.href} aria-label="ابحث في الديوان" title="ابحث في الديوان">
                  <svg class="ui-icon" aria-hidden="true"><use href="#i-search" /></svg>
                </a>
              )
            }
            <button
              class="iconbtn"
              type="button"
              id="randomPoem"
              aria-label="قصيدة عشوائية"
              title="قصيدة عشوائية"
              data-volumes={JSON.stringify(volumeSizes)}
            >
              <svg class="ui-icon" aria-hidden="true"><use href="#i-shuffle"></use></svg>
            </button>
            <button class="iconbtn" type="button" id="themeToggle" aria-label="تبديل الوضع الليلي" title="الوضع الليلي">
              <svg class="ui-icon theme-light-icon" aria-hidden="true"><use href="#i-moon"></use></svg>
              <svg class="ui-icon theme-dark-icon" aria-hidden="true"><use href="#i-sun"></use></svg>
            </button>
          </div>
        </div>
        {reading && <div class="reading-progress" aria-hidden="true"><span id="readingProgress"></span></div>}
      </header>

      <main class="main" id="main">
        <slot />
        <footer class="site-footer">نصّ الديوان وفهارسه · شعر الشريف محمد بن الحسين الرضي (٣٥٩–٤٠٦ هـ)</footer>
      </main>

      <nav class="mobile-nav" id="mobileNav" aria-label="التنقل على الهاتف">
        {mobileMenu.map((item) => <NavLink item={item} current={section} />)}
      </nav>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
    <!-- TEMPORARY font lab -->
    <FontLab />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        document.getElementById('themeToggle').addEventListener('click', function () {
          var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('radi-theme', next); } catch (e) {}
        });
        var random = document.getElementById('randomPoem');
        random.addEventListener('click', function () {
          // Poem ids are r<volume>-<three digits>; pick a volume weighted by its size.
          var sizes = JSON.parse(random.dataset.volumes);
          var total = sizes.reduce(function (a, b) { return a + b; }, 0);
          var pick = Math.floor(Math.random() * total);
          var v = 0;
          while (pick >= sizes[v]) { pick -= sizes[v]; v++; }
          location.href = '/poem/r' + (v + 1) + '-' + String(pick + 1).padStart(3, '0') + '/';
        });
        // Small screens: hide the top and bottom bars while reading down, show them on the way up.
        var lastY = scrollY, ticking = false;
        addEventListener('scroll', function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            var y = scrollY;
            if (Math.abs(y - lastY) > 8) {
              root.classList.toggle('bars-hidden', y > lastY && y > 240);
              lastY = y;
            }
            ticking = false;
          });
        }, { passive: true });
      })();
    </script>
  </body>
</html>
