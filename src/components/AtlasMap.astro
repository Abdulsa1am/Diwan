---
// Static SVG map: countries, the two rivers, and a linked dot per place with coordinates.
import { places, project, mapViewBox, countryPaths, rivers, placeHref } from '../lib/atlas';
import type { Place } from '../lib/atlas';
import { arCount } from '../scripts/shared';

interface Props {
  /** Highlight one place (on its own page). */
  focus?: Place;
  label: string;
}
const { focus, label } = Astro.props;
const instanceId = `map-${crypto.randomUUID()}`;
const sizeId = `${instanceId}-size`;
const mapped = places.filter((p) => p.lat !== undefined && p.lon !== undefined);
const max = Math.max(...mapped.map((p) => p.verses.length), 1);

// Place labels without overlaps: most-cited places first; each tries left, right, above, below its dot.
type Box = { x1: number; y1: number; x2: number; y2: number };
const hit = (a: Box, b: Box) => a.x1 < b.x2 && a.x2 > b.x1 && a.y1 < b.y2 && a.y2 > b.y1;
const dots = mapped
  .map((p) => {
    const { x, y } = project(p.lat!, p.lon!);
    const isFocus = focus?.name === p.name;
    const r = 4 + Math.sqrt(p.verses.length / max) * 9 + (isFocus ? 4 : 0);
    return { p, x, y, r, isFocus, box: { x1: x - r, y1: y - r, x2: x + r, y2: y + r } };
  })
  .sort((a, b) => Number(b.isFocus) - Number(a.isFocus) || b.p.verses.length - a.p.verses.length);
// Labels go in order of importance. A label avoids earlier labels and the dots of places at least as
// important; smaller places' dots may sit under it (their names show on hover and in the list).
const placedLabels: Box[] = [];
const labels = dots.map((d, i) => {
  const w = d.p.name.length * 10 + 8;
  const h = 23;
  const options = [
    { x: d.x - d.r - 3, y: d.y + 5, anchor: 'end', box: { x1: d.x - d.r - 3 - w, y1: d.y - h / 2, x2: d.x - d.r - 3, y2: d.y + h / 2 } },
    { x: d.x + d.r + 3, y: d.y + 5, anchor: 'start', box: { x1: d.x + d.r + 3, y1: d.y - h / 2, x2: d.x + d.r + 3 + w, y2: d.y + h / 2 } },
    { x: d.x, y: d.y - d.r - 4, anchor: 'middle', box: { x1: d.x - w / 2, y1: d.y - d.r - 4 - h, x2: d.x + w / 2, y2: d.y - d.r - 4 } },
    { x: d.x, y: d.y + d.r + 15, anchor: 'middle', box: { x1: d.x - w / 2, y1: d.y + d.r + 1, x2: d.x + w / 2, y2: d.y + d.r + 1 + h } },
  ];
  const blockers = [...placedLabels, ...dots.slice(0, i + 1).map((o) => o.box)];
  const fit = options.find((o) => !blockers.some((b) => hit(o.box, b)));
  if (fit) placedLabels.push(fit.box);
  return { ...d, label: fit };
});
---

<figure class="atlas-map glass">
  <input class="map-size-toggle" id={sizeId} type="checkbox" />
  <div class="map-viewport" tabindex="0" role="region" aria-label="الخريطة، قابلة للتمرير عند تكبيرها">
  <svg viewBox={mapViewBox} role="group" aria-label={label}>
    <g class="land">
      {countryPaths.map(([, d]) => <path d={d} />)}
    </g>
    <g class="rivers">
      {
        rivers.map((r) => (
          <polyline points={r.points}>
            <title>{r.name}</title>
          </polyline>
        ))
      }
    </g>
    <!-- Paint order retains the original emphasis; pointer picking uses every live point center. -->
    <g class="places">
      {
        [...labels].reverse().map(({ p, x, y, r, isFocus, label: l }) => (
          <a href={placeHref(p)} data-place-name={p.name} class:list={['place', { focus: isFocus, dim: focus && !isFocus }]}>
            <title>{`${p.name}: ${p.verses.length ? arCount(p.verses.length, ['شاهد واحد', 'شاهدان', 'شواهد', 'شاهدًا']) : 'في الحواشي'}`}</title>
            <circle class="place-hit" cx={x.toFixed(1)} cy={y.toFixed(1)} r="18" />
            <circle class="place-dot" cx={x.toFixed(1)} cy={y.toFixed(1)} r={r.toFixed(1)} />
            {l && (
              <text x={l.x.toFixed(1)} y={l.y.toFixed(1)} text-anchor={l.anchor}>
                {p.name}
              </text>
            )}
          </a>
        ))
      }
    </g>
  </svg>
  </div>
  <div class="map-controls">
    <label class="map-size-label" for={sizeId}>تكبير الخريطة</label>
    {focus && <a class="list-link" href="/explore/atlas/#places-list">قائمة المواضع</a>}
  </div>
  <p class="map-help">مرّر الخريطة أفقيًا وعموديًا.</p>
  <figcaption>حجم النقطة على قدر شواهد الموضع.</figcaption>
  <dialog class="map-picker" aria-labelledby={`${instanceId}-title`} aria-describedby={`${instanceId}-description`}>
    <h2 id={`${instanceId}-title`}>مواضع متقاربة</h2>
    <p id={`${instanceId}-description`}>اختر الموضع</p>
    <ul class="map-picker-places"></ul>
    <button type="button" class="map-picker-close">إغلاق</button>
  </dialog>
</figure>

<script>
  import '../scripts/atlas-map';
</script>

<style>
  /* Same palette as the site, with more separation between land, borders and rivers. */
  .atlas-map {
    --map-sea: #f6eddf;
    --map-land: #dfc6a3;
    --map-border: #a78059;
    --map-river: #98724e;
    margin: 0 0 18px;
    padding: 8px;
    overflow: hidden;
  }
  :global([data-theme='dark']) .atlas-map {
    --map-sea: #211813;
    --map-land: #493526;
    --map-border: #997552;
    --map-river: #bd9870;
  }
  .map-size-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .map-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 8px;
  }
  .map-size-label, .list-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 4px 8px;
    font-size: var(--fs-sm);
  }
  .map-size-label { cursor: pointer; }
  .map-size-label::before {
    content: '';
    width: 16px;
    height: 16px;
    margin-inline-end: 8px;
    border: 1px solid var(--accent);
    border-radius: 3px;
  }
  .map-size-toggle:checked ~ .map-controls .map-size-label::before {
    content: '\2713';
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--bg);
    line-height: 1;
  }
  .map-size-toggle:focus-visible ~ .map-controls .map-size-label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .map-help {
    display: none;
    margin: 0 8px;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .map-size-toggle:checked ~ .map-help { display: block; }
  .map-viewport {
    overflow: auto;
    max-height: 70vh;
    border-radius: 12px;
    direction: ltr;
  }
  .map-viewport:focus-visible, .map-size-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .map-size-toggle:checked ~ .map-viewport svg {
    min-width: 1100px;
  }
  svg {
    /* Label positions are computed left-to-right; Arabic names still render right-to-left inside. */
    direction: ltr;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    background: var(--map-sea);
    touch-action: pan-x pan-y pinch-zoom;
  }
  .land path {
    fill: var(--map-land);
    stroke: var(--map-border);
    stroke-width: 1;
  }
  .rivers polyline {
    fill: none;
    stroke: var(--map-river);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .place-hit {
    fill: transparent;
    stroke: none;
    pointer-events: all;
  }
  .place-dot {
    fill: var(--accent);
    fill-opacity: 0.75;
    stroke: var(--accent-deep);
    stroke-width: 1.4;
  }
  .place text {
    font-family: var(--ui-font);
    font-size: var(--fs-md);
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--map-sea);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .place:hover .place-dot,
  .place:focus-visible .place-dot,
  .place.focus .place-dot {
    fill-opacity: 1;
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  .place:focus-visible {
    outline: none;
  }
  .place:focus-visible .place-dot {
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }
  .map-picker {
    box-sizing: border-box;
    width: min(360px, calc(100vw - 32px));
    max-height: 80vh;
    max-height: 80dvh;
    overflow: hidden;
    padding: 20px;
    border: 1px solid var(--accent);
    border-radius: 16px;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--ui-font);
    direction: rtl;
  }
  .map-picker[open] { display: flex; flex-direction: column; }
  .map-picker::backdrop { background: rgb(0 0 0 / 45%); }
  .map-picker h2 { flex-shrink: 0; margin: 0 0 8px; font-size: 24px; }
  .map-picker p { flex-shrink: 0; margin: 0 0 12px; }
  .map-picker-places {
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    list-style: none;
    padding: 6px;
    margin: 0 0 12px;
  }
  .map-picker :global(a), .map-picker-close {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    min-height: 44px;
    width: 100%;
    padding: 10px 12px;
    overflow-wrap: anywhere;
    border: 1px solid var(--accent);
    border-radius: 8px;
    color: var(--ink);
    background: var(--bg);
    font: inherit;
  }
  .map-picker :global(li + li) { margin-top: 6px; }
  .map-picker-close { flex-shrink: 0; justify-content: center; cursor: pointer; }
  .map-picker :global(a:focus-visible), .map-picker-close:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  @media (forced-colors: active) {
    .map-picker { background: Canvas; color: CanvasText; border-color: CanvasText; }
    .map-picker :global(a), .map-picker-close {
      background: Canvas;
      color: LinkText;
      border-color: ButtonText;
    }
    .map-picker :global(a:focus-visible), .map-picker-close:focus-visible { outline-color: Highlight; }
  }
  .place:focus-visible text {
    font-weight: 700;
  }
  .place.dim {
    opacity: 0.45;
  }
  .place.focus text {
    font-weight: 700;
    font-size: 21px;
  }
  figcaption {
    font-size: var(--fs-xs);
    color: var(--muted);
    padding: 6px 8px 2px;
  }
</style>
