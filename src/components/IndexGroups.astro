---
// A list of index groups (meter, rhyme, theme…). Each group folds open to its poems.
// The poem links are in the HTML even when folded, so search engines see them.
import { ar } from '../lib/diwan';
import { anchor } from '../lib/indices';
import type { Group } from '../lib/indices';
import { arCount } from '../scripts/shared';

interface Props {
  groups: Group[];
  /** Largest group size, for the bar width. */
  max?: number;
  /** Link to the filtered poem list, e.g. (g) => `/diwan/?meter=${g.key}`. */
  filterLink?: (g: Group) => string;
}

const { groups, filterLink } = Astro.props;
const max = Astro.props.max ?? Math.max(...groups.map((g) => g.poems.length));
---

<ul class="groups">
  {
    groups.map((g) => (
      <li id={anchor(g.key)}>
        <details class="group glass">
          <summary>
            <span class="label">
              <b>{g.label}</b>
              {g.note && <small>{g.note}</small>}
            </span>
            <span class="bar" aria-hidden="true">
              <span style={`width:${Math.max(3, (g.poems.length / max) * 100)}%`} />
            </span>
            <span class="num">{arCount(g.poems.length, ['قصيدة واحدة', 'قصيدتان', 'قصائد', 'قصيدة'])}</span>
          </summary>
          <ol class="poems">
            {g.poems.map((p) => (
              <li>
                <a href={`/poem/${p.id}/`}>
                  <b>{p.title}</b>
                  <span>{p.verses[0].sadr}</span>
                </a>
              </li>
            ))}
          </ol>
          {filterLink && (
            <a class="filter-link" href={filterLink(g)}>
              عرضها بطاقاتٍ في الديوان
            </a>
          )}
        </details>
      </li>
    ))
  }
</ul>

<style>
  .groups {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .groups > li {
    scroll-margin-top: 90px;
  }
  .group {
    padding: 0;
  }
  summary {
    display: grid;
    grid-template-columns: minmax(7rem, 1.2fr) 2fr auto;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .label {
    display: flex;
    flex-direction: column;
    line-height: 1.5;
  }
  .label b {
    font-family: var(--display-font);
    font-weight: 400;
    font-size: 24px;
  }
  .label small {
    font-size: 12px;
    color: var(--muted);
  }
  .bar {
    height: 8px;
    background: var(--chip-bg);
    border-radius: 8px;
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 8px;
    opacity: 0.75;
  }
  .num {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }
  details[open] summary {
    border-bottom: 1px solid var(--line-dark);
  }
  .poems {
    list-style: none;
    margin: 0;
    padding: 8px 10px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 2px 12px;
  }
  .poems a {
    display: flex;
    flex-direction: column;
    padding: 8px 10px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    line-height: 1.6;
  }
  .poems a:hover {
    background: var(--paper-strong);
  }
  .poems b {
    font-family: var(--display-font);
    font-weight: 400;
    font-size: 20px;
  }
  .poems span {
    font-family: var(--poem-font);
    font-size: 16px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .filter-link {
    display: inline-block;
    margin: 0 20px 14px;
    font-size: 14px;
  }
  @media (max-width: 560px) {
    summary {
      grid-template-columns: 1fr auto;
    }
    .bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
