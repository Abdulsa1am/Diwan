---
// A grid of verses, each linking to its place in the poem.
import { ar } from '../lib/diwan';
import type { Poem, Verse } from '../lib/diwan';

interface Props {
  refs: { poem: Poem; verse: Verse }[];
}
const { refs } = Astro.props;
---

<ul class="verse-list">
  {
    refs.map(({ poem, verse }) => (
      <li>
        <a href={`/poem/${poem.id}/#v${verse.n}`}>
          <span>{verse.sadr}</span>
          {verse.ajuz && <span>{verse.ajuz}</span>}
          <small>
            «{poem.title}»، البيت {ar(verse.n)}
          </small>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .verse-list {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
    gap: 8px;
  }
  a {
    min-height: 44px;
    display: grid;
    height: 100%;
    align-content: center;
    text-align: center;
    font-family: var(--poem-font);
    font-size: 23px;
    line-height: 1.9;
    padding: 12px;
    border-radius: 14px;
    background: var(--paper);
    border: 1px solid var(--glass-border);
    color: var(--ink);
    text-decoration: none;
  }
  a:hover {
    background: var(--paper-strong);
  }
  small {
    font-family: var(--ui-font);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
</style>
