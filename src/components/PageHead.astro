---
interface Props {
  title: string;
  lede?: string;
  /** Small line above the title, e.g. the parent section. */
  parent?: { label: string; href: string };
}
const { title, lede, parent } = Astro.props;
---

<header class="page-head">
  {
    parent && (
      <a class="parent" href={parent.href}>
        <svg class="ui-icon" aria-hidden="true">
          <use href="#i-arrow-right" />
        </svg>
        {parent.label}
      </a>
    )
  }
  <h1>{title}</h1>
  {lede && <p>{lede}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding: 4px 0 18px;
  }
  .parent {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-sm);
    color: var(--muted);
    text-decoration: none;
    min-height: 44px;
  }
  .parent .ui-icon {
    width: 18px;
    height: 18px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 54px);
    color: var(--accent-deep);
    margin: 0;
  }
  :global([data-theme='dark']) h1 {
    color: var(--ink);
  }
  p {
    color: var(--muted);
    margin: 0;
    font-size: var(--fs-md);
    max-width: 640px;
  }
</style>
