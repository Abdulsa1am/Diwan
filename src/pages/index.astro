---
import Base from '../layouts/Base.astro';
import { poems, poemById, ar, POET, SITE_NAME } from '../lib/diwan';

const verseCount = poems.reduce((sum, p) => sum + p.verses.length, 0);
const first = poemById.get('r1-001')!;

const description = `ديوان الشريف الرضي كاملًا: ${ar(poems.length)} قصيدة و${ar(verseCount)} بيتًا، مع البحر والقافية والحواشي لكل قصيدة.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: new URL('/', Astro.site).href,
  inLanguage: 'ar',
  about: { '@type': 'Person', name: POET, sameAs: 'https://ar.wikipedia.org/wiki/الشريف_الرضي' },
};
---

<Base title={`${SITE_NAME}: القصائد والفهارس`} description={description} jsonLd={jsonLd} section="home">
  <div class="welcome">
    <div>
      <span class="overline">القصائد والفهارس</span>
      <h2>{SITE_NAME}</h2>
    </div>
    <span class="edition">ديوانٌ من القرن الرابع الهجري</span>
  </div>

  <section class="hero" aria-labelledby="heroTitle">
    <div class="hero-copy">
      <div class="tag"><span></span> نصّ الديوان · فهارس · أدوات قراءة</div>
      <h1 id="heroTitle">ديوان الشريف<br />الرضي</h1>
      <p>قصائد الشريف الرضي، مع البحر والقافية والحواشي لكل قصيدة.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/diwan/">
          <svg class="ui-icon" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
          افتح الديوان
        </a>
        <a class="btn" href={`/poem/${first.id}/`}>ابدأ بأول قصيدة</a>
      </div>
      <p class="hero-count">{ar(poems.length)} قصيدة · {ar(verseCount)} بيتًا · جزآن</p>
    </div>
    <div class="hero-art" aria-hidden="true"></div>
  </section>
</Base>

<style>
  .welcome {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .overline {
    font-size: 12px;
    color: var(--muted);
  }
  .welcome h2 {
    font-size: 30px;
    margin: 0;
    line-height: 1.5;
  }
  .edition {
    font-size: 13px;
    color: var(--accent);
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    overflow: hidden;
    min-height: 345px;
    background: linear-gradient(124deg, rgba(255, 255, 255, 0.76), rgba(244, 249, 254, 0.35) 72%);
    border: 1px solid var(--glass-border);
    border-radius: 26px;
    box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    margin-bottom: 28px;
  }
  :global([data-theme='dark']) .hero {
    background: linear-gradient(128deg, rgba(69, 88, 111, 0.52), rgba(29, 47, 68, 0.42));
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    padding: 44px 46px;
  }
  .tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .tag span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  h1 {
    font-size: clamp(54px, 8.2vw, 102px);
    line-height: 1.34;
    margin: 19px 0 14px;
    text-wrap: balance;
  }
  .hero-copy > p {
    max-width: 490px;
    font-size: clamp(15px, 2vw, 19px);
    color: var(--muted);
    line-height: 1.85;
    margin: 0 0 25px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .hero-actions .btn {
    font-size: 15px;
    padding: 12px 22px;
  }
  .hero-copy > .hero-count {
    font-size: 12px;
    margin: 22px 0 0;
  }

  /* Two rotated glass sheets, as in the old hero. */
  .hero-art {
    position: relative;
    min-height: 330px;
    isolation: isolate;
    background: radial-gradient(rgba(176, 209, 233, 0.34), transparent 67%);
  }
  .hero-art::before,
  .hero-art::after {
    content: '';
    position: absolute;
    width: 200px;
    height: 255px;
    border-radius: 21px;
    border: 1px solid rgba(255, 255, 255, 0.79);
    box-shadow: 16px 24px 42px rgba(42, 79, 112, 0.12), inset 2px 2px 1px rgba(255, 255, 255, 0.64);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .hero-art::before {
    right: calc(50% - 92px);
    top: calc(50% - 138px);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.66), rgba(186, 214, 237, 0.27));
    transform: rotate(-12deg);
  }
  .hero-art::after {
    right: calc(50% - 110px);
    top: calc(50% - 124px);
    background: linear-gradient(140deg, rgba(255, 255, 255, 0.39), rgba(145, 185, 217, 0.18));
    transform: rotate(9deg);
  }
  :global([data-theme='dark']) .hero-art::before,
  :global([data-theme='dark']) .hero-art::after {
    background: linear-gradient(140deg, rgba(204, 233, 252, 0.21), rgba(112, 150, 188, 0.08));
    border-color: rgba(234, 247, 255, 0.26);
  }

  @media (max-width: 1000px) {
    .hero-copy {
      padding: 34px 30px;
    }
    .hero-art::before,
    .hero-art::after {
      scale: 0.78;
    }
  }
  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-art {
      display: none;
    }
    .welcome {
      display: none;
    }
  }
  @media (max-width: 620px) {
    h1 {
      font-size: clamp(52px, 14vw, 75px);
      line-height: 1.28;
    }
    .hero-copy {
      padding: 30px 22px;
    }
  }
</style>
