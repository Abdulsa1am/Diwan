---
import Base from '../layouts/Base.astro';
import { poems, ar, POET, SITE_NAME } from '../lib/diwan';
import { sections } from '../lib/nav';

const verseCount = poems.reduce((sum, p) => sum + p.verses.length, 0);
const first = poems[0];

// Verse of the day: openings of the longer poems, spread evenly over the diwan.
// The page shows the first one; a small script picks today's.
const candidates = poems.filter((p) => p.verses.length >= 25 && p.verses[0].ajuz);
const step = candidates.length / 60;
const daily = Array.from({ length: 60 }, (_, i) => candidates[Math.floor(i * step)]).map((p) => ({
  id: p.id,
  title: p.title,
  sadr: p.verses[0].sadr,
  ajuz: p.verses[0].ajuz!,
  meter: p.meter,
}));
const today = daily[0];

// Entry points: only sections that exist are linked.
const entries = [
  { item: sections.library, text: `${ar(poems.length)} قصيدة مرتبة على القوافي` },
  { item: { ...sections.library, key: 'reading', label: 'ابدأ القراءة', href: `/poem/${first.id}/` }, text: first.title },
  { item: sections.indexes, text: 'البحور والقوافي والمطالع' },
  { item: sections.themes, text: 'المدح والرثاء والفخر والحنين…' },
  { item: sections.about, text: 'سيرة الشاعر وعن هذه النسخة' },
  { item: sections.saved, text: 'القصائد التي حفظتها' },
].filter((e) => e.item.href);

const description = `ديوان الشريف الرضي كاملًا: ${ar(poems.length)} قصيدة و${ar(verseCount)} بيتًا، مع البحر والقافية وشروح الأبيات.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: new URL('/', Astro.site).href,
  inLanguage: 'ar',
  about: { '@type': 'Person', name: POET, sameAs: 'https://ar.wikipedia.org/wiki/الشريف_الرضي' },
};
---

<Base title={`${SITE_NAME}: القصائد والفهارس`} description={description} jsonLd={jsonLd} section="home">
  <div class="welcome">
    <div>
      <span class="overline">القصائد والفهارس</span>
    </div>
    <span class="edition">ديوانٌ من القرن الرابع الهجري</span>
  </div>

  <section class="hero glass" aria-labelledby="heroTitle">
    <div class="hero-copy">
      <h1 id="heroTitle" aria-label="ديوان الشريف الرضي">
        <span class="diwan-title"><span class="diwan-plain">ديوان</span><span class="diwan-ornament" aria-hidden="true" data-kashida="ديـــــــــــــــــــــوان"></span></span>{' '}
        <span class="poet-name">الشريف الرضي</span>
      </h1>
      <p>قصائد الشريف الرضي، مع البحر والقافية وشروح الأبيات.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/diwan/">
          <svg class="ui-icon" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
          افتح الديوان
        </a>
        <a class="btn" href={`/poem/${first.id}/`}>ابدأ بأول قصيدة</a>
      </div>
      <p class="hero-count">{ar(poems.length)} قصيدة، و{ar(verseCount)} بيتًا، في جزأين</p>
    </div>
    <div class="hero-art" aria-hidden="true"></div>
  </section>

  <form class="home-search glass" action="/search/" method="get" role="search">
    <svg class="ui-icon" aria-hidden="true"><use href="#i-search"></use></svg>
    <label class="visually-hidden" for="homeQ">ابحث في أبيات الديوان</label>
    <input id="homeQ" name="q" type="search" placeholder="ابحث بلفظة أو شطر من بيت…" enterkeyhint="search" />
    <button class="btn btn-primary" type="submit">ابحث</button>
  </form>

  <div class="home-duo">
    <section class="daily glass" aria-labelledby="dailyTitle">
      <h2 id="dailyTitle">بيت اليوم</h2>
      <blockquote>
        <p data-daily-sadr>{today.sadr}</p>
        <p data-daily-ajuz>{today.ajuz}</p>
      </blockquote>
      <a class="daily-source" href={`/poem/${today.id}/`} data-daily-link>
        مطلع «<span data-daily-title>{today.title}</span>»، <span data-daily-meter>{today.meter}</span>
      </a>
    </section>

    <section class="entries" aria-label="أقسام الديوان">
      {
        entries.map(({ item, text }) => (
          <a class:list={['entry', 'glass', { primary: item.key === 'library' || item.key === 'reading' }]} href={item.href} id={item.key === 'reading' ? 'resume' : undefined}>
            <svg class="ui-icon" aria-hidden="true">
              <use href={`#${item.icon}`} />
            </svg>
            <span>
              <b data-resume-label={item.key === 'reading' ? '' : undefined}>{item.label}</b>
              <small data-resume-title={item.key === 'reading' ? '' : undefined}>{text}</small>
              {item.key === 'reading' && <small data-resume-pos></small>}
            </span>
          </a>
        ))
      }
    </section>
  </div>

  <script type="application/json" id="dailyVerses" set:html={JSON.stringify(daily)} />
</Base>

<script>
  import { load, LAST_KEY } from '../scripts/shared';
  import type { PoemRef } from '../scripts/shared';

  // Only the ي–و connection is elongated; the selectable heading stays plain text.
  const title = document.getElementById('heroTitle')!;
  const diwan = title.querySelector<HTMLElement>('.diwan-ornament')!;
  const poet = title.querySelector<HTMLElement>('.poet-name')!;
  const pen = document.createElement('canvas').getContext('2d');
  let titleFrame = 0;
  const fitKashida = () => {
    titleFrame = 0;
    if (!pen) return;
    const font = getComputedStyle(title);
    pen.font = `${font.fontWeight} ${font.fontSize} ${font.fontFamily}`;
    pen.direction = 'rtl';
    const range = document.createRange();
    range.selectNodeContents(poet);
    const target = Math.min(range.getBoundingClientRect().width, title.clientWidth);
    if (!target) return;
    let best = 'ديوان', error = Infinity;
    for (let n = 0; n <= 64; n++) {
      const word = `دي${'\u0640'.repeat(n)}وان`;
      const width = pen.measureText(word).width;
      if (width <= title.clientWidth && Math.abs(width - target) < error) {
        best = word;
        error = Math.abs(width - target);
      }
    }
    diwan.dataset.kashida = best;
  };
  const scheduleTitle = () => { titleFrame ||= requestAnimationFrame(fitKashida); };
  void document.fonts.ready.then(scheduleTitle);
  document.fonts.addEventListener('loadingdone', scheduleTitle);
  window.addEventListener('radi:fontchange', scheduleTitle);
  new ResizeObserver(scheduleTitle).observe(title);

  const digits = new Intl.NumberFormat('ar-EG', { useGrouping: false });

  // Continue reading: the last poem opened on this device.
  const last = load<PoemRef | null>(LAST_KEY, null);
  const resume = document.getElementById('resume') as HTMLAnchorElement;
  if (last?.id) {
    resume.href = `/poem/${last.id}/${last.verse && last.verse > 1 ? `#v${last.verse}` : ''}`;
    resume.querySelector('[data-resume-label]')!.textContent = 'تابع القراءة';
    resume.querySelector('[data-resume-title]')!.textContent = last.title;
    resume.querySelector('[data-resume-pos]')!.textContent =
      last.verse && last.total ? `البيت ${digits.format(last.verse)} من ${digits.format(last.total)}` : '';
  }

  // Verse of the day: same verse for everyone on the same day.
  const daily = JSON.parse(document.getElementById('dailyVerses')!.textContent!) as {
    id: string;
    title: string;
    sadr: string;
    ajuz: string;
    meter: string;
  }[];
  const now = new Date();
  const dayOfYear = Math.floor((Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) - Date.UTC(now.getFullYear(), 0, 0)) / 864e5);
  const pick = daily[dayOfYear % daily.length];
  const set = (sel: string, text: string) => (document.querySelector(sel)!.textContent = text);
  set('[data-daily-sadr]', pick.sadr);
  set('[data-daily-ajuz]', pick.ajuz);
  set('[data-daily-title]', pick.title);
  set('[data-daily-meter]', pick.meter);
  (document.querySelector('[data-daily-link]') as HTMLAnchorElement).href = `/poem/${pick.id}/`;
</script>

<style>
  .welcome {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .overline {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .welcome h2 {
    font-size: 30px;
    margin: 0;
    line-height: 1.5;
  }
  .edition {
    font-size: var(--fs-xs);
    color: var(--accent);
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    overflow: hidden;
    min-height: 345px;
    background: linear-gradient(124deg, rgba(255, 252, 246, 0.74), rgba(250, 240, 226, 0.36) 72%);
    border: 1px solid var(--glass-border);
    border-radius: 26px;
    box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    margin-bottom: 18px;
  }
  :global([data-theme='dark']) .hero {
    background: linear-gradient(128deg, rgba(86, 64, 46, 0.55), rgba(44, 32, 24, 0.45));
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    padding: 28px clamp(22px, 3vw, 40px);
    min-width: 0;
    container-type: inline-size;
  }
  h1 {
    font-size: clamp(44px, 6vw, 72px);
    font-size: clamp(32px, 15cqi, 72px);
    line-height: 1.45;
    margin: 12px 0;
  }
  h1 span {
    display: block;
  }
  .diwan-title { position: relative; }
  .diwan-plain { color: transparent; }
  .diwan-ornament {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
  }
  .diwan-ornament::after { content: attr(data-kashida); }
  @media (forced-colors: active) {
    .diwan-plain { color: CanvasText; }
    .diwan-title .diwan-ornament { display: none; }
  }
  .poet-name {
    white-space: nowrap;
  }
  .hero-copy > p {
    max-width: 490px;
    font-size: clamp(15px, 2vw, 19px);
    color: var(--muted);
    line-height: 1.85;
    margin: 0 0 25px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .hero-actions .btn {
    font-size: var(--fs-md);
    padding: 12px 22px;
  }
  .hero-copy > .hero-count {
    font-size: var(--fs-xs);
    margin: 22px 0 0;
  }

  /* Two rotated glass sheets, as in the old hero. */
  .hero-art {
    position: relative;
    min-height: 330px;
    isolation: isolate;
    background: radial-gradient(rgba(214, 178, 130, 0.3), transparent 67%);
  }
  .hero-art::before,
  .hero-art::after {
    content: '';
    position: absolute;
    width: 200px;
    height: 255px;
    border-radius: 21px;
    border: 1px solid rgba(255, 255, 255, 0.79);
    box-shadow: 16px 24px 42px rgba(90, 60, 30, 0.18), inset 2px 2px 1px rgba(255, 255, 255, 0.64);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .hero-art::before {
    right: calc(50% - 92px);
    top: calc(50% - 138px);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.66), rgba(222, 192, 150, 0.25));
    transform: rotate(-12deg);
  }
  .hero-art::after {
    right: calc(50% - 110px);
    top: calc(50% - 124px);
    background: linear-gradient(140deg, rgba(255, 255, 255, 0.39), rgba(196, 150, 100, 0.16));
    transform: rotate(9deg);
  }
  :global([data-theme='dark']) .hero-art::before,
  :global([data-theme='dark']) .hero-art::after {
    background: linear-gradient(140deg, rgba(255, 226, 190, 0.16), rgba(160, 110, 60, 0.06));
    border-color: rgba(255, 236, 210, 0.2);
  }

  .home-search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 8px 8px 8px;
    padding-inline-start: 18px;
    margin-bottom: 18px;
  }
  .home-search:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .home-search .ui-icon {
    color: var(--muted);
  }
  .home-search input {
    flex: 1;
    min-width: 0;
    width: 100%;
    border: 0;
    background: none;
    font: 400 19px/1.6 var(--poem-font);
    color: var(--ink);
  }
  .home-search input:focus {
    outline: none;
  }
  .home-duo {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 18px;
    margin-bottom: 18px;
  }
  .daily {
    padding: 24px 26px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .daily h2 {
    font-size: 27px;
    color: var(--accent);
    margin: 0 0 6px;
  }
  .daily blockquote {
    margin: 0 0 12px;
    font-family: var(--poem-font);
    font-size: clamp(25px, 3.4vw, 31px);
    line-height: 2;
  }
  .daily blockquote p {
    margin: 0;
  }
  .daily-source {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .entries {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .entry {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    min-height: 44px;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }
  .entry .ui-icon {
    flex-shrink: 0;
    color: var(--accent);
    width: 22px;
    height: 22px;
  }
  .entry span {
    min-width: 0;
    overflow-wrap: anywhere;
    display: flex;
    flex-direction: column;
    line-height: 1.5;
  }
  .entry b {
    font-weight: 600;
    font-size: var(--fs-md);
  }
  .entry small {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .entry:hover {
    background: var(--paper-strong);
  }

  @media (max-width: 1000px) {
    .hero-copy {
      padding: 34px 30px;
    }
    .hero-art::before,
    .hero-art::after {
      scale: 0.78;
    }
  }
  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-copy {
      text-align: center;
    }
    .hero-actions {
      justify-content: center;
    }
    h1 {
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;
    }
    .diwan-ornament {
      inset-inline: 0;
    }
    .hero-copy > p {
      margin-inline: auto;
    }
    .hero-art,
    .welcome,
    .home-search,
    .hero-actions,
    .hero-copy > p {
      display: none;
    }
    .home-duo {
      grid-template-columns: 1fr;
    }
    .entries {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .entries { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .entry { gap: 8px; padding: 10px 12px; }
    .entry.primary { grid-column: 1 / -1; }
    .entry:not(.primary) small { display: none; }
    .hero {
      min-height: 0;
      margin-bottom: 12px;
    }
    h1 {
      font-size: clamp(38px, 13vw, 64px);
      font-size: clamp(32px, 15cqi, 64px);
      line-height: 1.45;
      margin: 10px auto;
    }
    .hero-copy {
      padding: 20px 22px;
    }
    .hero-copy > p {
      margin-bottom: 14px;
    }
    .hero-actions {
      gap: 8px;
    }
    .hero-actions .btn {
      padding: 9px 14px;
      min-height: 44px;
    }
    .hero-copy > .hero-count {
      margin-top: 12px;
    }
  }
  @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) { .hero { background: var(--surface-solid); } }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) { .hero { background: var(--surface-solid); backdrop-filter: none; } }
</style>
