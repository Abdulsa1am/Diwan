---
import Base from '../layouts/Base.astro';
import { poems, ar, versesLabel, SITE_NAME } from '../lib/diwan';

const meters = [...new Set(poems.map((p) => p.meter))].sort((a, b) => a.localeCompare(b, 'ar'));
const rhymes = [...new Set(poems.map((p) => p.rhyme))];
const title = `الديوان | ${SITE_NAME}`;
const description = `فهرس قصائد ديوان الشريف الرضي (${ar(poems.length)} قصيدة) مرتبة على القوافي في جزأين.`;
---

<Base title={title} description={description} section="library">
  <header class="page-head">
    <h1>الديوان</h1>
    <p>قصائد الديوان كلها مرتبة على حروف القافية في جزأين.</p>
  </header>

  <p class="count" id="filterNotice">تظهر قائمة القصائد كاملة. التصفية تحتاج إلى JavaScript وتبقى معطّلة حتى يكتمل تحميلها.</p>
  <form class="filter-bar glass" id="filters" role="search" aria-label="تصفية القصائد">
    <label class="title-filter">
      <svg class="ui-icon" aria-hidden="true"><use href="#i-search"></use></svg>
      <span class="visually-hidden">عنوان القصيدة أو مطلعها</span>
      <input disabled name="t" type="search" placeholder="عنوان أو مطلع…" autocomplete="off" />
    </label>
    <details class="filter-options" id="filterOptions">
      <summary id="filterSummary" aria-label="تصفية القصائد" title="تصفية القصائد">
        <svg class="ui-icon" aria-hidden="true"><use href="#i-sliders"></use></svg>
        <span class="filter-summary-text">تصفية</span>
      </summary>
      <div class="filter-fields">
        <select disabled name="meter" aria-label="البحر">
          <option value="">البحور كلها</option>
          {meters.map((m) => <option value={m}>{m}</option>)}
        </select>
        <select disabled name="rhyme" aria-label="القافية">
          <option value="">القوافي كلها</option>
          {rhymes.map((r) => <option value={r}>{r}</option>)}
        </select>
        <select disabled name="vol" aria-label="الجزء">
          <option value="">الجزآن</option>
          <option value="1">الجزء الأول</option>
          <option value="2">الجزء الثاني</option>
        </select>
      </div>
    </details>
  </form>

  <div class="filter-restrictions" id="catalogueRestrictions" hidden>
    <span id="catalogueRestrictionText"></span>
    <button class="btn" type="button" id="clearFilters">إزالة القيود</button>
  </div>
  <p class="count" id="count" aria-live="polite" tabindex="-1">في الديوان {ar(poems.length)} قصيدة</p>
  <nav class="rhyme-jump" id="rhymeJump" aria-label="انتقل إلى حرف القافية" hidden>
    {rhymes.map((r) => <button type="button" data-jump-rhyme={r} aria-label={`قافية ${r}`}>{r}</button>)}
  </nav>
  <p class="no-match glass" id="noMatch" hidden>
    لا قصائد تطابق البحث. جرّب عنوانًا أو مطلعًا آخر، أو <a href="/search/">ابحث في الأبيات</a>.
  </p>

  <nav class="catalogue-paging" data-catalogue-paging aria-label="صفحات القصائد" hidden>
    <button type="button" data-page-step="-1">السابق</button>
    <label>الصفحة <select data-page-select aria-label="انتقل إلى صفحة القصائد"></select></label>
    <span data-page-status></span>
    <button type="button" data-page-step="1">التالي</button>
  </nav>

  <div class="cards">
    {
      poems.map((p, index) => (
        <a
          class="poem-card glass"
          href={`/poem/${p.id}/`}
          data-meter={p.meter}
          data-rhyme={p.rhyme}
          data-vol={p.volume}
        >
          <div class="card-heading">
            <span class="catalogue-number"><span class="visually-hidden">ترتيب الفهرس: </span>{ar(index + 1)}</span>
            <h2>{p.title}</h2>
          </div>
          <div class="meta">
            <span class="chip">{p.meter}</span>
            <span class="chip">{p.qafiya}</span>
          </div>
          <div class="preview-verse">
            <span class="opening-half">{p.verses[0].sadr}</span>
            {p.verses[0].ajuz && (
              <>
                <br class="opening-break" />
                <span class="opening-end">{p.verses[0].ajuz}</span>
              </>
            )}
          </div>
          <div class="compact-meta">{p.meter}، {versesLabel(p.verses.length)}</div>
          <div class="card-foot">
            <span>{versesLabel(p.verses.length)}</span>
            <span>
              ج {ar(p.volume)}، ص {ar(p.startPage)}
            </span>
          </div>
        </a>
      ))
    }
  </div>
  <nav class="catalogue-paging" data-catalogue-paging aria-label="صفحات القصائد، أسفل القائمة" hidden>
    <button type="button" data-page-step="-1">السابق</button>
    <label>الصفحة <select data-page-select aria-label="انتقل إلى صفحة القصائد، أسفل القائمة"></select></label>
    <span data-page-status></span>
    <button type="button" data-page-step="1">التالي</button>
  </nav>
</Base>

<script>
  import { fold } from '../scripts/arabic-search';
  import { arCount } from '../scripts/shared';

  // Keep build-time corpus shaping out of the browser bundle.
  const ar = (n: number) => n.toLocaleString('ar-EG', { useGrouping: false });

  const form = document.getElementById('filters') as HTMLFormElement;
  const cards = [...document.querySelectorAll<HTMLAnchorElement>('.poem-card')];
  const count = document.getElementById('count')!;
  const restrictions = document.getElementById('catalogueRestrictions')!;
  const restrictionText = document.getElementById('catalogueRestrictionText')!;
  const noMatch = document.getElementById('noMatch')!;
  const filterOptions = document.getElementById('filterOptions') as HTMLDetailsElement;
  const jump = document.getElementById('rhymeJump')!;
  const jumpButtons = [...jump.querySelectorAll<HTMLButtonElement>('button')];
  const firstByRhyme = new Map<string, HTMLAnchorElement>();
  const pagers = [...document.querySelectorAll<HTMLElement>('[data-catalogue-paging]')];
  const pageSize = 50;
  let page = 1;
  let matched: HTMLAnchorElement[] = [];
  const phone = matchMedia('(max-width: 620px)');
  const syncDisclosure = () => { filterOptions.open = !phone.matches; };
  syncDisclosure();
  phone.addEventListener('change', syncDisclosure);
  // Native details/summary supplies keyboard activation and its expanded state.

  const folded = new Map<HTMLElement, string>();
  const textOf = (card: HTMLElement) => {
    if (!folded.has(card)) folded.set(card, fold(card.querySelector('h2')!.textContent! + ' ' + card.querySelector('.preview-verse')!.textContent!).text);
    return folded.get(card)!;
  };

  function writeUrl(mode: 'push' | 'replace') {
    const url = new URL(location.href);
    for (const name of ['t', 'meter', 'rhyme', 'vol']) {
      const value = (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement).value;
      url.searchParams.delete(name);
      if (value) url.searchParams.set(name, value);
    }
    url.searchParams.delete('page');
    url.searchParams.set('page', String(page));
    if (url.href !== location.href) {
      if (mode === 'push') history.pushState(null, '', url);
      else history.replaceState(null, '', url);
    }
  }

  function focusResult(target: HTMLElement = count) {
    target.focus({ preventScroll: true });
    target.scrollIntoView({ block: 'start' });
  }

  function renderPage(requested: number, mode: 'push' | 'replace', moveFocus = false) {
    const totalPages = Math.max(1, Math.ceil(matched.length / pageSize));
    page = Math.min(totalPages, Math.max(1, Number.isFinite(requested) ? Math.trunc(requested) : 1));
    const start = (page - 1) * pageSize;
    const visible = new Set(matched.slice(start, start + pageSize));
    for (const card of cards) card.hidden = !visible.has(card);
    const totalLabel = arCount(matched.length, ['قصيدة واحدة', 'قصيدتان', 'قصائد', 'قصيدة']);
    const matchedLabel = matched.length === cards.length ? totalLabel : `${totalLabel} من ${ar(cards.length)}`;
    count.textContent = matchedLabel + (matched.length
      ? `، عرض ${ar(start + 1)}–${ar(Math.min(start + pageSize, matched.length))}، الصفحة ${ar(page)} من ${ar(totalPages)}`
      : '');
    noMatch.hidden = matched.length > 0;
    for (const pager of pagers) {
      pager.hidden = totalPages <= 1;
      const select = pager.querySelector<HTMLSelectElement>('[data-page-select]')!;
      if (select.options.length !== totalPages) {
        select.replaceChildren(...Array.from({ length: totalPages }, (_, index) => new Option(ar(index + 1), String(index + 1))));
      }
      select.value = String(page);
      pager.querySelector('[data-page-status]')!.textContent = `من ${ar(totalPages)}`;
      for (const button of pager.querySelectorAll<HTMLButtonElement>('[data-page-step]')) {
        button.disabled = Number(button.dataset.pageStep) < 0 ? page === 1 : page === totalPages;
      }
    }
    writeUrl(mode);
    // Move away from paging controls before a last/first-page button can strand focus.
    if (moveFocus) focusResult();
  }

  function apply(requested = 1) {
    const fd = new FormData(form);
    const t = fold(String(fd.get('t') ?? '')).text;
    const meter = String(fd.get('meter') ?? '');
    const rhyme = String(fd.get('rhyme') ?? '');
    const vol = String(fd.get('vol') ?? '');
    matched = [];
    firstByRhyme.clear();
    for (const card of cards) {
      const ok =
        (!meter || card.dataset.meter === meter) &&
        (!rhyme || card.dataset.rhyme === rhyme) &&
        (!vol || card.dataset.vol === vol) &&
        (!t || textOf(card).includes(t));
      if (ok) {
        matched.push(card);
        if (!firstByRhyme.has(card.dataset.rhyme!)) firstByRhyme.set(card.dataset.rhyme!, card);
      }
    }
    const labels = [meter && `البحر: ${meter}`, rhyme && `القافية: ${rhyme}`, vol && `الجزء ${vol === '1' ? 'الأول' : 'الثاني'}`].filter(Boolean);
    restrictionText.textContent = `القيود: ${labels.join('، ')}`;
    restrictions.hidden = !labels.length;
    for (const button of jumpButtons) button.disabled = !firstByRhyme.has(button.dataset.jumpRhyme!);
    renderPage(requested, 'replace');
  }

  function restoreUrl() {
    const params = new URLSearchParams(location.search);
    for (const name of ['t', 'meter', 'rhyme', 'vol']) {
      const control = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
      control.value = params.get(name) ?? (control instanceof HTMLInputElement ? control.defaultValue : [...control.options].find((option) => option.defaultSelected)?.value ?? '');
      if (control instanceof HTMLSelectElement && control.selectedIndex < 0) control.value = '';
    }
    const rawPage = params.get('page') ?? '1';
    apply(/^\d+$/.test(rawPage) ? Number(rawPage) : 1);
  }

  jump.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-jump-rhyme]');
    if (!button || button.disabled) return;
    const card = firstByRhyme.get(button.dataset.jumpRhyme!);
    if (!card) return;
    renderPage(Math.floor(matched.indexOf(card) / pageSize) + 1, 'push');
    focusResult(card);
  });
  for (const pager of pagers) {
    pager.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-page-step]');
      if (button && !button.disabled) renderPage(page + Number(button.dataset.pageStep), 'push', true);
    });
    pager.querySelector<HTMLSelectElement>('[data-page-select]')!.addEventListener('change', (event) => {
      renderPage(Number((event.target as HTMLSelectElement).value), 'push', true);
    });
  }
  form.addEventListener('input', () => apply());
  form.addEventListener('submit', (event) => event.preventDefault());
  form.addEventListener('reset', () => queueMicrotask(() => apply()));
  document.getElementById('clearFilters')!.addEventListener('click', () => {
    for (const select of form.querySelectorAll('select')) select.value = '';
    apply();
    (form.elements.namedItem('t') as HTMLInputElement).focus();
  });
  window.addEventListener('popstate', () => {
    restoreUrl();
    focusResult();
  });

  // Enable only when handlers are ready; failed downloads leave the full static catalogue.
  for (const control of form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')) control.disabled = false;
  restoreUrl();
  jump.hidden = false;
  document.getElementById('filterNotice')!.hidden = true;
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 10px;
    margin-top: 16px;
  }
  .filter-options {
    flex: 3 1 380px;
    min-width: 0;
  }
  .filter-options summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    list-style: none;
    width: fit-content;
    min-width: 44px;
    min-height: 44px;
    align-content: center;
    padding: 6px 12px;
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    background: var(--paper-strong);
    color: var(--ink);
    font-size: 14px;
    cursor: pointer;
  }
  .filter-options summary::-webkit-details-marker { display: none; }
  .filter-options summary::marker { content: ""; }
  .filter-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 8px;
  }
  @media (min-width: 621px) {
    .filter-options[open] summary { display: none; }
    .filter-fields { padding-top: 0; }
  }
  .rhyme-jump {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding: 4px;
    margin-bottom: 12px;
  }
  .rhyme-jump[hidden] { display: none; }
  .rhyme-jump button {
    flex: 0 0 44px;
    min-height: 44px;
    border: 1px solid var(--line-dark);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    font: 500 18px/1.5 var(--ui-font);
    cursor: pointer;
  }
  .rhyme-jump button:disabled { opacity: .35; cursor: default; }
  .compact-meta { display: none; }
  .title-filter {
    min-width: 0;
    flex: 1 1 220px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--paper-strong);
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    padding: 0 12px;
    min-height: 44px;
  }
  .title-filter:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .title-filter .ui-icon {
    color: var(--muted);
    width: 18px;
    height: 18px;
  }
  .title-filter input {
    flex: 1;
    min-width: 0;
    width: 100%;
    border: 0;
    background: none;
    font: 400 16px/1.6 var(--ui-font);
    color: var(--ink);
  }
  .title-filter input:focus {
    outline: none;
  }
  .filter-bar select {
    flex: 1 1 120px;
    font: 400 14px/1.6 var(--ui-font);
    color: var(--ink);
    background: var(--paper-strong);
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    padding: 6px 10px;
    min-height: 44px;
  }
  .no-match {
    padding: 16px 20px;
    text-align: center;
  }
  .no-match[hidden],
  .poem-card[hidden] {
    display: none;
  }
  .link-btn {
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }
  .page-head {
    padding: 8px 0 4px;
  }
  .page-head h1 {
    font-size: clamp(36px, 6vw, 48px);
    color: var(--accent-deep);
    margin: 0;
  }
  :global([data-theme='dark']) .page-head h1 {
    color: var(--ink);
  }
  .page-head p {
    color: var(--muted);
    margin: 0;
    font-size: 14px;
  }
  .count {
    color: var(--muted);
    font-size: 14px;
    margin: 24px 0 14px;
  }
  .catalogue-paging {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0;
    font-size: 14px;
  }
  .catalogue-paging[hidden] { display: none; }
  .catalogue-paging label { display: flex; align-items: center; gap: 6px; }
  .catalogue-paging button, .catalogue-paging select {
    min-width: 44px;
    min-height: 44px;
    padding: 6px 10px;
    border: 1px solid var(--line-dark);
    border-radius: 10px;
    color: var(--ink);
    background: var(--paper-strong);
    font: inherit;
  }
  .catalogue-paging button { cursor: pointer; }
  .catalogue-paging button:disabled { opacity: .45; cursor: default; }
  .count { scroll-margin-top: 100px; }
  .card-heading { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .card-heading h2 { min-width: 0; }
  .catalogue-number { flex: none; color: var(--muted); font: 500 14px/1.7 var(--ui-font); font-variant-numeric: tabular-nums; }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 16px;
  }
  .poem-card {
    display: flex;
    flex-direction: column;
    padding: 21px;
    color: var(--ink);
    text-decoration: none;
    /* Render off-screen cards lazily: the list has 685 of them. */
    content-visibility: auto;
    contain-intrinsic-size: auto 260px;
    scroll-margin-top: 100px;
  }
  .poem-card:hover {
    background: var(--paper-strong);
  }
  .poem-card h2 {
    font-size: 26px;
    margin: 0 0 6px;
    line-height: 1.5;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .meta .chip {
    border: 1px solid var(--line-dark);
  }
  .preview-verse {
    font-family: var(--poem-font);
    font-size: 21px;
    line-height: 1.9;
    margin: 18px 0 14px;
    flex: 1;
  }
  .preview-verse .opening-end {
    color: var(--muted);
  }
  .card-foot {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line-dark);
    padding-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 620px) {
    .filter-bar { display: block; position: relative; }
    .title-filter { margin-inline-end: 50px; }
    .filter-options summary {
      position: absolute;
      top: 10px;
      inset-inline-end: 10px;
      width: 44px;
      height: 44px;
      padding: 0;
    }
    .filter-summary-text { display: none; }
    .filter-options[open] summary { background: var(--paper); border-color: var(--accent); }
    .filter-fields select { min-width: 0; }
    .count { margin: 12px 0 4px; }
    .cards { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .poem-card {
      min-width: 0;
      padding: 7px 14px;
      contain-intrinsic-size: auto 96px;
    }
    .poem-card h2 {
      font-family: var(--display-font);
      font-size: 24px;
      line-height: 1.5;
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .poem-card .meta, .card-foot, .opening-break, .opening-end { display: none; }
    .preview-verse {
      flex: none;
      margin: 0;
      font-size: 20px;
      line-height: 1.9;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .compact-meta {
      display: block;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.7;
    }
  }
</style>
