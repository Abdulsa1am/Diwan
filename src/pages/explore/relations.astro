---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE_NAME, ar } from '../../lib/diwan';
import relations from '../../../data/edition/relations.json';
import { places, placeHref } from '../../lib/atlas';
import { arCount } from '../../scripts/shared';

type Related = { name: string; type: string; shared: number; score: number };
type Term = { label: string; type: string; poems: number; related: Related[] };

const terms = (Object.values(relations.terms) as Term[])
  .filter((t) => t.related.length)
  .sort((a, b) => b.poems - a.poems);
const placeNames = new Set(places.map((p) => p.name));
const termLabels = new Set(terms.map((t) => t.label));
const groups = [
  { type: 'لفظ', title: 'الألفاظ', terms: terms.filter((t) => t.type === 'لفظ') },
  { type: 'موضع', title: 'المواضع', terms: terms.filter((t) => t.type === 'موضع') },
];

const title = `شبكة العلاقات في ديوان الشريف الرضي | ${SITE_NAME}`;
const description = 'الألفاظ والمواضع التي تجتمع في قصائد الشريف الرضي: لكل لفظة أكثر ما يرافقها في القصائد نفسها.';
---

<Base title={title} description={description} section="indexes">
  <PageHead
    title="شبكة العلاقات"
    lede={`لكل لفظة أو موضع: أكثر ما يجتمع معه في القصائد نفسها. ${ar(terms.length)} مدخلًا.`}
    parent={{ label: 'الفهارس', href: '/explore/' }}
  >
    <p class="caveat">
      حُسبت العلاقات من اجتماع الألفاظ في القصائد والأبيات، قبل آخر مراجعة لشواهد الأطلس؛ فهي قرائن للاستكشاف لا أحكام.
    </p>
  </PageHead>

  {
    groups.map((g) => (
      <section aria-labelledby={`g-${g.type}`}>
        <h2 class="group-title" id={`g-${g.type}`}>
          {g.title}
        </h2>
        <ul class="terms">
          {g.terms.map((t) => (
            <li id={t.label}>
              <details>
                <summary>
                  <b>{t.label}</b>
                  <small>{arCount(t.poems, ['قصيدة واحدة', 'قصيدتان', 'قصائد', 'قصيدة'])}</small>
                </summary>
                <p class="with">يجتمع في القصائد مع:</p>
                <ul class="related">
                  {t.related.slice(0, 12).map((r) => (
                    <li>
                      {r.type === 'موضع' && placeNames.has(r.name) ? (
                        <a href={placeHref(r.name)}>{r.name}<small>{ar(r.shared)}</small></a>
                      ) : termLabels.has(r.name) ? (
                        <a href={`#${r.name}`}>{r.name}<small>{ar(r.shared)}</small></a>
                      ) : (
                        <span>{r.name}<small>{ar(r.shared)}</small></span>
                      )}
                    </li>
                  ))}
                </ul>
                <a class="search" href={`/search/?q=${encodeURIComponent(t.label)}`}>
                  ابحث عن «{t.label}» في الأبيات
                </a>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<script>
  // Opening a #term link unfolds that entry.
  function openTarget() {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = id && document.getElementById(id);
    if (el) {
      el.querySelector('details')?.setAttribute('open', '');
      el.scrollIntoView({ block: 'start' });
    }
  }
  window.addEventListener('hashchange', openTarget);
  openTarget();
</script>

<style>
  .caveat {
    font-size: 13px;
    color: var(--muted);
    margin: 6px 0 0;
  }
  .group-title {
    font-size: 30px;
    margin: 16px 0 8px;
  }
  .terms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 8px;
    align-items: start;
  }
  .terms > li {
    scroll-margin-top: 90px;
  }
  details {
    border-radius: 14px;
    background: var(--paper);
    border: 1px solid var(--glass-border);
  }
  details[open] {
    background: var(--paper-strong);
  }
  summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary b {
    font-family: var(--poem-font);
    font-weight: 400;
    font-size: 21px;
  }
  summary small,
  .related small {
    font-size: 13px;
    color: var(--muted);
  }
  .with {
    font-size: 13px;
    color: var(--muted);
    margin: 0 14px 4px;
  }
  .related {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0 14px;
  }
  .related li {
    border-radius: 8px;
    background: var(--chip-bg);
    font-family: var(--poem-font);
    font-size: 16px;
  }
  .related a {
    text-decoration: none;
  }
  .related a,
  .related li > span {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    padding: 2px 10px;
  }
  @media (max-width: 620px) {
    .related a,
    .related li > span {
      min-height: 40px;
      align-items: center;
    }
  }
  .search {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    margin: 10px 14px 12px;
  }
</style>
