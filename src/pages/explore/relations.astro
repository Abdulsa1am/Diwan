---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE_NAME, ar } from '../../lib/diwan';
import relations from '../../../data/edition/relations.json';
import { places, placeHref } from '../../lib/atlas';
import { arCount } from '../../scripts/shared';

type Related = { name: string; type: string; shared: number; score: number };
type Term = { label: string; type: string; poems: number; related: Related[] };

const terms = (Object.values(relations.terms) as Term[])
  .filter((t) => t.related.length)
  .sort((a, b) => b.poems - a.poems);
const placeNames = new Set(places.map((p) => p.name));
const termLabels = new Set(terms.map((t) => t.label));
const groups = [
  { type: 'لفظ', title: 'الألفاظ', terms: terms.filter((t) => t.type === 'لفظ') },
  { type: 'موضع', title: 'المواضع', terms: terms.filter((t) => t.type === 'موضع') },
];

const title = `شبكة العلاقات في ديوان الشريف الرضي | ${SITE_NAME}`;
const description = 'الألفاظ والمواضع التي تجتمع في قصائد الشريف الرضي: لكل لفظة أكثر ما يرافقها في القصائد نفسها.';
---

<Base title={title} description={description} section="indexes">
  <PageHead
    title="شبكة العلاقات"
    parent={{ label: 'الفهارس', href: '/explore/' }}
  >
    <p class="caveat">
      حُسبت العلاقات من اجتماع الألفاظ في القصائد والأبيات، قبل آخر مراجعة لشواهد الأطلس؛ فهي قرائن للاستكشاف لا أحكام.
    </p>
  </PageHead>

  <label class="find glass"><span>تصفية المداخل</span><input id="findRelations" type="search" placeholder="ابحث عن لفظة أو موضع…" autocomplete="off" /></label>
  <p id="relationsCount" role="status" aria-live="polite"></p>
  {
    groups.map((g) => (
      <section class="relation-group" aria-labelledby={`g-${g.type}`}>
        <h2 class="group-title" id={`g-${g.type}`}>
          {g.title}
        </h2>
        <ul class="terms">
          {g.terms.map((t) => (
            <li id={t.label} data-term={t.label}>
              <details>
                <summary>
                  <span class="disclosure" aria-hidden="true">⌄</span><b>{t.label}</b>
                  <small>{arCount(t.poems, ['قصيدة واحدة', 'قصيدتان', 'قصائد', 'قصيدة'])}</small>
                </summary>
                <ul class="related">
                  {t.related.slice(0, 12).map((r) => (
                    <li>
                      {r.type === 'موضع' && placeNames.has(r.name) ? (
                        <a href={placeHref(r.name)} aria-label={`${r.name}، ${arCount(r.shared, ['قصيدة مشتركة واحدة', 'قصيدتان مشتركتان', 'قصائد مشتركة', 'قصيدة مشتركة'])}`}>{r.name}<small>{ar(r.shared)}</small></a>
                      ) : termLabels.has(r.name) ? (
                        <a href={`#${r.name}`} aria-label={`${r.name}، ${arCount(r.shared, ['قصيدة مشتركة واحدة', 'قصيدتان مشتركتان', 'قصائد مشتركة', 'قصيدة مشتركة'])}`}>{r.name}<small>{ar(r.shared)}</small></a>
                      ) : (
                        <span>{r.name}<small>{arCount(r.shared, ['قصيدة مشتركة واحدة', 'قصيدتان مشتركتان', 'قصائد مشتركة', 'قصيدة مشتركة'])}</small></span>
                      )}
                    </li>
                  ))}
                </ul>
                <a class="search" href={`/search/?q=${encodeURIComponent(t.label)}`}>
                  ابحث عن «{t.label}» في الأبيات
                </a>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<script>
  import { fold } from '../../scripts/arabic-search';
  import { arCount } from '../../scripts/shared';
  const input = document.getElementById('findRelations') as HTMLInputElement;
  const status = document.getElementById('relationsCount')!;
  const items = [...document.querySelectorAll<HTMLLIElement>('.terms > li')].map((li) => ({ li, term: fold(li.dataset.term ?? '').text }));
  const filter = () => {
    const q = fold(input.value).text;
    let shown = 0;
    for (const { li, term } of items) {
      li.hidden = Boolean(q) && !term.includes(q);
      if (!li.hidden) shown++;
    }
    for (const group of document.querySelectorAll<HTMLElement>('.relation-group')) {
      group.hidden = !group.querySelector('.terms > li:not([hidden])');
    }
    status.textContent = q ? arCount(shown, ['مدخل واحد', 'مدخلان', 'مداخل', 'مدخلًا']) : '';
  };
  input.addEventListener('input', filter);
  input.addEventListener('search', filter);
  // Opening a #term link unfolds that entry.
  function openTarget() {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = id && document.getElementById(id);
    if (el) {
      if (el.hidden) { input.value = ''; filter(); }
      el.querySelector('details')?.setAttribute('open', '');
      el.scrollIntoView({ block: 'start' });
    }
  }
  window.addEventListener('hashchange', openTarget);
  openTarget();
</script>

<style>
  .find { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 10px 14px; }
  .find input { flex: 1 1 200px; min-width: 0; min-height: 44px; font: var(--fs-md) var(--ui-font); color: var(--ink); background: var(--paper-strong); border: 1px solid var(--glass-border); border-radius: 8px; padding: 6px 10px; }
  #relationsCount { font-size: var(--fs-sm); color: var(--muted); }
  #relationsCount:empty { margin: 0; }
  .terms > li[hidden], .relation-group[hidden] { display: none; }
  .caveat {
    font-size: var(--fs-xs);
    color: var(--muted);
    margin: 6px 0 0;
  }
  .group-title {
    font-size: 34px;
    margin: 16px 0 8px;
  }
  .terms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 8px;
    align-items: start;
  }
  .terms > li {
    scroll-margin-top: 90px;
  }
  details {
    border-radius: 14px;
    background: var(--paper);
    border: 1px solid var(--glass-border);
  }
  details[open] {
    background: var(--paper-strong);
  }
  summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .disclosure { transition: transform 120ms; color: var(--accent); }
  details[open] .disclosure { transform: rotate(180deg); }
  summary small { margin-inline-start: auto; }
  summary b {
    font-family: var(--poem-font);
    font-weight: 400;
    font-size: 24px;
  }
  summary small,
  .related small {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .related {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0 14px;
  }
  .related li {
    border-radius: 8px;
    background: var(--chip-bg);
    font-family: var(--poem-font);
    font-size: var(--fs-md);
  }
  .related a {
    text-decoration: none;
  }
  .related a,
  .related li > span {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    padding: 2px 10px;
  }
  @media (max-width: 620px) {
    .related a,
    .related li > span {
      min-height: 40px;
      align-items: center;
    }
  }
  .search {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-xs);
    margin: 10px 14px 12px;
  }
</style>
