---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE_NAME, ar } from '../../lib/diwan';
import { rhymeGroups } from '../../lib/indices';

const title = `مطالع قصائد الشريف الرضي | ${SITE_NAME}`;
const description = 'فهرس مطالع قصائد ديوان الشريف الرضي: البيت الأول من كل قصيدة، مرتبًا على القوافي.';
---

<Base title={title} description={description} section="indexes">
  <PageHead
    title="المطالع"
    lede="البيت الأول من كل قصيدة، مرتبًا على القوافي. يُعرف كثير من القصائد بمطلعها."
    parent={{ label: 'الفهارس', href: '/explore/' }}
  />

  <label class="find glass">
    <svg class="ui-icon" aria-hidden="true"><use href="#i-search"></use></svg>
    <span class="visually-hidden">ابحث في المطالع</span>
    <input id="findMatla" type="search" placeholder="ابحث في المطالع…" autocomplete="off" />
    <output id="matlaCount" aria-live="polite"></output>
  </label>

  <nav class="letters" aria-label="انتقل إلى حرف الروي">
    {rhymeGroups.map((g) => <a href={`#r-${g.key}`}>{g.key}</a>)}
  </nav>

  {
    rhymeGroups.map((g) => (
      <section class="rhyme" aria-labelledby={`r-${g.key}`}>
        <h2 id={`r-${g.key}`}>
          {g.label} <small data-group-count>{ar(g.poems.length)}</small>
        </h2>
        <ol class="matali">
          {g.poems.map((p) => (
            <li>
              <a href={`/poem/${p.id}/`}>
                <span class="verse">
                  <span>{p.verses[0].sadr}</span>
                  {p.verses[0].ajuz && <span>{p.verses[0].ajuz}</span>}
                </span>
                <small>
                  {p.title}، {p.meter}
                </small>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>

<script>
  import { fold } from '../../scripts/arabic-search';
  import { arCount } from '../../scripts/shared';

  const input = document.getElementById('findMatla') as HTMLInputElement;
  const out = document.getElementById('matlaCount')!;
  const items = [...document.querySelectorAll<HTMLLIElement>('.matali li')].map((li) => ({
    li,
    text: fold(li.textContent ?? '').text,
  }));
  const sections = [...document.querySelectorAll<HTMLElement>('.rhyme')];

  const jumps = [...document.querySelectorAll<HTMLAnchorElement>('.letters a')];
  const filter = () => {
    const q = fold(input.value).text;
    let shown = 0;
    for (const { li, text } of items) {
      li.hidden = Boolean(q) && !text.includes(q);
      if (!li.hidden) shown++;
    }
    for (const [i, section] of sections.entries()) {
      const count = section.querySelectorAll('li:not([hidden])').length;
      section.hidden = count === 0;
      section.querySelector('[data-group-count]')!.textContent = arCount(count, ['مطلع واحد', 'مطلعان', 'مطالع', 'مطلعًا']);
      jumps[i].hidden = count === 0;
    }
    out.textContent = q ? arCount(shown, ['مطلع واحد', 'مطلعان', 'مطالع', 'مطلعًا']) : '';
  };
  input.addEventListener('input', filter);
  input.addEventListener('search', filter);
  filter();
</script>

<style>
  .letters {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    gap: 6px;
    margin-bottom: 12px;
  }
  .letters::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 700px) {
    .letters {
      flex-wrap: wrap;
    }
  }
  .letters a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-width: 44px;
    min-height: 44px;
    padding: 2px 10px;
    background: var(--chip-bg);
    border-radius: 8px;
    text-decoration: none;
    font-family: var(--poem-font);
  }
  .letters a[hidden] {
    display: none;
  }
  .rhyme h2 {
    scroll-margin-top: 145px;
  }
  .find {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    margin-bottom: 18px;
    position: sticky;
    top: 70px;
    z-index: 5;
    background: var(--paper-strong);
  }
  .find:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .find .ui-icon {
    color: var(--muted);
  }
  .find input {
    flex: 1;
    min-width: 0;
    width: 100%;
    border: 0;
    background: none;
    font: 400 19px/2 var(--poem-font);
    color: var(--ink);
  }
  .find input:focus {
    outline: none;
  }
  .find output {
    font-size: var(--fs-xs);
    color: var(--muted);
    white-space: nowrap;
  }
  .rhyme[hidden],
  .matali li[hidden] {
    display: none;
  }
  .rhyme h2 {
    font-size: 29px;
    margin: 18px 0 8px;
  }
  .rhyme h2 small {
    font-family: var(--ui-font);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .matali {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
    gap: 8px;
  }
  .matali a {
    display: block;
    padding: 6px 12px;
    border-radius: 14px;
    background: var(--paper);
    border: 1px solid var(--glass-border);
    text-decoration: none;
    color: var(--ink);
    content-visibility: auto;
    contain-intrinsic-size: auto 95px;
  }
  .matali a:hover {
    background: var(--paper-strong);
  }
  .verse {
    display: grid;
    font-family: var(--poem-font);
    font-size: 23px;
    line-height: 1.55;
    text-align: center;
  }
  .matali small {
    display: block;
    text-align: center;
    font-size: var(--fs-xs);
    color: var(--muted);
    margin-top: 2px;
  }
</style>
