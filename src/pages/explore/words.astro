---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE_NAME, ar } from '../../lib/diwan';
import frequencies from '../../../data/edition/word-frequencies.json';
import { arCount } from '../../scripts/shared';

// Rebuilt at data preparation time; only selected words enter this static page.
const words: { word: string; count: number; poems: number }[] = frequencies.words;
const max = words[0].count;
const title = `الألفاظ الأكثر دورانًا في شعر الشريف الرضي | ${SITE_NAME}`;
const description = `أكثر الألفاظ ورودًا في ديوان الشريف الرضي: ${words
  .slice(2, 12)
  .map((w) => w.word)
  .join('، ')}، مع عدد مراتها وقصائدها.`;
---

<Base title={title} description={description} section="indexes">
  <PageHead
    title="فهرس الألفاظ"
    lede={`${ar(words.length)} لفظة من أكثر ألفاظ الديوان ورودًا. اختر لفظة لتبحث عنها في الأبيات.`}
    parent={{ label: 'الفهارس', href: '/explore/' }}
  >
    <p class="caveat" id="word-count-method">نعدّ كل ورود للكلمة كاملةً في شعر الرضي، مع إهمال التشكيل وتوحيد صور الحروف كما في البحث؛ وتبقى «والزمان» مستقلةً عن «الزمان». لا تدخل الأبيات المنقولة في مقدمات القصائد في العدّ. فتح البطاقة ينقلك إلى البحث، الذي يعدّ الأبيات المطابقة ويجد اللفظة داخل كلمات أطول؛ لذلك قد تختلف نتائجه عن مرات الورود هنا.</p>
  </PageHead>

  <label class="find glass">
    <span>تصفية الألفاظ</span>
    <input id="findFrequency" type="search" placeholder="ابحث عن لفظة في هذه القائمة…" autocomplete="off" aria-describedby="word-count-method" />
  </label>
  <p id="frequencyCount" role="status" aria-live="polite"></p>

  <ol class="words">
    {
      words.map((w) => (
        <li data-word={w.word}>
          <a href={`/search/?q=${encodeURIComponent(w.word)}`} style={`--w:${Math.max(8, (w.count / max) * 100)}%`}>
            <b>{w.word}</b>
            <span>
              {arCount(w.count, ['مرة واحدة', 'مرتين', 'مرات', 'مرة'])} في {arCount(w.poems, ['قصيدة واحدة', 'قصيدتين', 'قصائد', 'قصيدة'])}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<script>
  import { fold } from '../../scripts/arabic-search';
  import { arCount } from '../../scripts/shared';
  const input = document.getElementById('findFrequency') as HTMLInputElement;
  const status = document.getElementById('frequencyCount')!;
  const items = [...document.querySelectorAll<HTMLLIElement>('.words li')].map((li) => ({ li, word: fold(li.dataset.word ?? '').text }));
  const filter = () => {
    const q = fold(input.value).text;
    let shown = 0;
    for (const { li, word } of items) {
      li.hidden = Boolean(q) && !word.includes(q);
      if (!li.hidden) shown++;
    }
    status.textContent = q ? arCount(shown, ['لفظة واحدة', 'لفظتان', 'ألفاظ', 'لفظة']) : '';
  };
  input.addEventListener('input', filter);
  input.addEventListener('search', filter);
  filter();
</script>

<style>
  .find {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding: 10px 14px;
  }
  .find input {
    flex: 1 1 200px;
    min-width: 0;
    width: 100%;
    min-height: 44px;
    font: 16px var(--ui-font);
    color: var(--ink);
    background: var(--paper-strong);
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    padding: 6px 10px;
  }
  #frequencyCount {
    font-size: 14px;
    color: var(--muted);
  }
  #frequencyCount:empty {
    margin: 0 0 12px;
  }
  .words li[hidden] {
    display: none;
  }

  .caveat {
    font-size: 13px;
    color: var(--muted);
    margin: 6px 0 0;
  }
  .words {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 6px;
  }
  .words a {
    position: relative;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 12px;
    background: var(--paper);
    border: 1px solid var(--glass-border);
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
    isolation: isolate;
  }
  .words a::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: var(--w);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    z-index: -1;
  }
  .words a:hover {
    background: var(--paper-strong);
  }
  .words b {
    font-family: var(--poem-font);
    font-weight: 400;
    font-size: 21px;
  }
  .words span {
    font-size: 13px;
    color: var(--muted);
    text-align: end;
  }
</style>
