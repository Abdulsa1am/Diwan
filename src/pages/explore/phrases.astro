---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE_NAME } from '../../lib/diwan';
---

<Base
  title={`شجرة العبارة في شعر الشريف الرضي | ${SITE_NAME}`}
  description="اكتب لفظة لترى الكلمات التي تسبقها وتليها في أبيات ديوان الشريف الرضي، وابنِ العبارة كلمة كلمة."
  section="indexes"
>
  <PageHead
    title="شجرة العبارة"
    lede="اكتب لفظة لترى ما يسبقها وما يليها في أبيات الديوان. اختر كلمة لتمدّ العبارة بها."
    parent={{ label: 'الفهارس', href: '/explore/' }}
  />

  <form class="phrase-form glass" id="phraseForm">
    <label class="visually-hidden" for="phraseInput">اللفظة أو العبارة</label>
    <input id="phraseInput" name="q" type="search" placeholder="مثلًا: الدهر" autocomplete="off" enterkeyhint="go" />
    <button class="btn btn-primary" type="submit">ابنِ الشجرة</button>
  </form>

  <p class="status" id="phraseStatus" role="status" aria-live="polite">جرّب: الدهر، الزمان، الشيب، بغداد.</p>

  <div class="tree" id="tree" hidden>
    <section class="branch glass" aria-labelledby="beforeTitle">
      <h2 id="beforeTitle">قبلها</h2>
      <ol id="before"></ol>
    </section>
    <div class="phrase" id="phrase" aria-live="polite"></div>
    <section class="branch glass" aria-labelledby="afterTitle">
      <h2 id="afterTitle">بعدها</h2>
      <ol id="after"></ol>
    </section>
  </div>

  <section class="samples" id="samplesWrap" hidden aria-labelledby="samplesTitle">
    <h2 id="samplesTitle">في الأبيات</h2>
    <ol id="samples"></ol>
  </section>

  <noscript><p class="status">هذه الأداة تحتاج إلى تفعيل JavaScript.</p></noscript>
</Base>

<script>
  import { loadCorpus } from '../../scripts/corpus';
  import { fold, findAll, highlight } from '../../scripts/arabic-search';
  import { arCount } from '../../scripts/shared';

  const form = document.getElementById('phraseForm') as HTMLFormElement;
  const input = document.getElementById('phraseInput') as HTMLInputElement;
  const statusEl = document.getElementById('phraseStatus')!;
  const tree = document.getElementById('tree')!;
  const phraseEl = document.getElementById('phrase')!;
  const beforeEl = document.getElementById('before')!;
  const afterEl = document.getElementById('after')!;
  const samplesWrap = document.getElementById('samplesWrap')!;
  const samplesEl = document.getElementById('samples')!;
  const digits = new Intl.NumberFormat('ar-EG');

  input.addEventListener('focus', () => loadCorpus(), { once: true });

  async function build(query: string) {
    const terms = fold(query).text.split(' ').filter(Boolean);
    if (!terms.length) return;
    history.replaceState(null, '', `?q=${encodeURIComponent(query)}`);
    statusEl.textContent = 'جارٍ البناء…';
    const corpus = await loadCorpus();

    const before = new Map<string, number>();
    const after = new Map<string, number>();
    const hits: typeof corpus.verses = [];
    for (const v of corpus.verses) {
      const w = v.words;
      let found = false;
      for (let i = 0; i + terms.length <= w.length; i++) {
        if (terms.every((t, k) => w[i + k] === t)) {
          found = true;
          if (i > 0) before.set(w[i - 1], (before.get(w[i - 1]) ?? 0) + 1);
          const next = w[i + terms.length];
          if (next) after.set(next, (after.get(next) ?? 0) + 1);
        }
      }
      if (found) hits.push(v);
    }

    if (!hits.length) {
      tree.hidden = true;
      samplesWrap.hidden = true;
      statusEl.textContent = `لم ترد «${query}» بهذه الصورة كلمةً مستقلة. جرّب صورة أخرى (بـ«ال» أو بدونها).`;
      return;
    }
    statusEl.textContent = `وردت في ${arCount(hits.length, ['بيت واحد', 'بيتين', 'أبيات', 'بيتًا'])}.`;
    tree.hidden = false;
    phraseEl.textContent = query;
    renderBranch(beforeEl, before, (w) => `${corpus.spell(w)} ${query}`, corpus.spell);
    renderBranch(afterEl, after, (w) => `${query} ${corpus.spell(w)}`, corpus.spell);

    samplesWrap.hidden = false;
    samplesEl.replaceChildren(
      ...hits.slice(0, 30).map((v) => {
        const p = corpus.poems[v.poem];
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/poem/${p[0]}/#v${v.n}`;
        a.innerHTML = `<span class="v">${v.text
          .split(' # ')
          .map((half) => `<span>${highlight(half, findAll(fold(half), [terms.join(' ')]) ?? [])}</span>`)
          .join('')}</span><small></small>`;
        a.querySelector('small')!.textContent = `«${p[1]}»، البيت ${digits.format(v.n)}`;
        li.append(a);
        return li;
      }),
    );
  }

  function renderBranch(
    list: HTMLElement,
    counts: Map<string, number>,
    next: (w: string) => string,
    spell: (w: string) => string,
  ) {
    const top = [...counts].sort((a, b) => b[1] - a[1]).slice(0, 14);
    list.replaceChildren(
      ...top.map(([word, n]) => {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.innerHTML = `<b></b><small></small>`;
        b.querySelector('b')!.textContent = spell(word);
        b.querySelector('small')!.textContent = digits.format(n);
        b.addEventListener('click', () => {
          input.value = next(word);
          build(input.value);
        });
        li.append(b);
        return li;
      }),
    );
    if (!top.length) {
      const li = document.createElement('li');
      li.className = 'empty';
      li.textContent = 'لا شيء';
      list.append(li);
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    build(input.value.trim());
  });
  const q = new URLSearchParams(location.search).get('q');
  if (q) {
    input.value = q;
    build(q);
  }
</script>

<style>
  .phrase-form {
    display: flex;
    gap: 8px;
    padding: 8px;
    padding-inline-start: 16px;
    margin-bottom: 8px;
  }
  .phrase-form:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .phrase-form input {
    flex: 1;
    min-width: 0;
    width: 100%;
    border: 0;
    background: none;
    font: 400 20px/1.8 var(--poem-font);
    color: var(--ink);
  }
  .phrase-form input:focus {
    outline: none;
  }
  .status {
    color: var(--muted);
    font-size: 14px;
    margin: 6px 4px 14px;
  }
  .tree {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 14px;
    align-items: start;
  }
  .tree[hidden],
  .samples[hidden] {
    display: none;
  }
  .phrase {
    align-self: center;
    font-family: var(--poem-font);
    font-size: 30px;
    padding: 10px 18px;
    border-radius: 16px;
    background: var(--primary-bg);
    color: var(--primary-ink);
    text-align: center;
  }
  .branch {
    padding: 12px 14px;
  }
  .branch h2 {
    font-size: 22px;
    margin: 0 0 6px;
  }
  .branch ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .branch :global(button) {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    border: 1px solid var(--line-dark);
    background: var(--paper-strong);
    color: var(--ink);
    border-radius: 10px;
    padding: 4px 10px;
    cursor: pointer;
    min-height: 36px;
  }
  .branch :global(button b) {
    font-family: var(--poem-font);
    font-weight: 400;
    font-size: 18px;
  }
  .branch :global(button small) {
    font-size: 12px;
    color: var(--muted);
  }
  .branch :global(.empty) {
    font-size: 13px;
    color: var(--muted);
  }
  .samples h2 {
    font-size: 26px;
    margin: 18px 0 8px;
  }
  .samples ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
    gap: 8px;
  }
  .samples :global(a) {
    display: grid;
    text-align: center;
    padding: 12px;
    border-radius: 14px;
    background: var(--paper);
    border: 1px solid var(--glass-border);
    color: var(--ink);
    text-decoration: none;
  }
  .samples :global(.v) {
    display: grid;
    font-family: var(--poem-font);
    font-size: 20px;
    line-height: 1.9;
  }
  .samples :global(small) {
    font-size: 13px;
    color: var(--muted);
  }
  .samples :global(mark) {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: inherit;
    border-radius: 4px;
  }
  @media (max-width: 760px) {
    .tree {
      grid-template-columns: 1fr;
    }
    .phrase {
      order: -1;
    }
  }
</style>
