---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE_NAME } from '../../lib/diwan';
---

<Base
  title={`شجرة العبارة في شعر الشريف الرضي | ${SITE_NAME}`}
  description="اكتب لفظة لترى الكلمات التي تسبقها وتليها في أبيات ديوان الشريف الرضي، وابنِ العبارة كلمة كلمة."
  section="indexes"
>
  <PageHead
    title="شجرة العبارة"
    lede="اكتب لفظة لترى ما يسبقها وما يليها في الأبيات."
    parent={{ label: 'الفهارس', href: '/explore/' }}
  />

  <form class="phrase-form glass" id="phraseForm">
    <label class="visually-hidden" for="phraseInput">اللفظة أو العبارة</label>
    <input id="phraseInput" name="q" type="search" placeholder="مثلًا: الدهر" autocomplete="off" enterkeyhint="go" />
    <button class="btn btn-primary" type="submit">ابنِ الشجرة</button>
  </form>

  <div class="examples" aria-label="جرّب">
    <span>جرّب:</span>
    {['الدهر', 'الزمان', 'الشيب', 'بغداد'].map((word) => <a href={`/explore/phrases/?q=${word}`}>{word}</a>)}
  </div>
  <p class="status" id="phraseStatus" role="status" aria-live="polite"></p>

  <button class="btn" id="phraseRetry" type="button" hidden>أعد المحاولة</button>

  <div class="tree" id="tree" hidden>
    <section class="branch glass" aria-labelledby="beforeTitle">
      <h2 id="beforeTitle">قبلها</h2>
      <ol id="before"></ol>
    </section>
    <div class="phrase" id="phrase" tabindex="-1"></div>
    <section class="branch glass" aria-labelledby="afterTitle">
      <h2 id="afterTitle">بعدها</h2>
      <ol id="after"></ol>
    </section>
  </div>

  <section class="samples" id="samplesWrap" hidden aria-labelledby="samplesTitle">
    <h2 id="samplesTitle">في الأبيات</h2>
    <ol id="samples"></ol>
  </section>

  <noscript><p class="status">هذه الأداة تحتاج إلى تفعيل JavaScript.</p></noscript>
</Base>

<script>
  import { loadCorpus, phraseRanges } from '../../scripts/corpus';
  import { fold, highlight } from '../../scripts/arabic-search';
  import { arCount } from '../../scripts/shared';

  const form = document.getElementById('phraseForm') as HTMLFormElement;
  const input = document.getElementById('phraseInput') as HTMLInputElement;
  const statusEl = document.getElementById('phraseStatus')!;
  const tree = document.getElementById('tree')!;
  const phraseEl = document.getElementById('phrase')!;
  const samplesWrap = document.getElementById('samplesWrap')!;
  const samplesEl = document.getElementById('samples')!;
  const retry = document.getElementById('phraseRetry') as HTMLButtonElement;
  const digits = new Intl.NumberFormat('ar-EG');
  let generation = 0;

  function queryURL(query: string) {
    const url = new URL(location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }
  function clear() {
    generation++;
    tree.hidden = samplesWrap.hidden = retry.hidden = true;
    input.value = '';
    samplesEl.replaceChildren();
    document.getElementById('before')!.replaceChildren();
    document.getElementById('after')!.replaceChildren();
    phraseEl.textContent = '';
    statusEl.textContent = '';
    queryURL('');
  }
  // Speculative loading must never create an unhandled rejection.
  input.addEventListener('focus', () => { void loadCorpus().catch(() => {}); }, { once: true });
  const onEdit = () => {
    if (!fold(input.value).text) { clear(); return; }
    generation++;
    tree.hidden = samplesWrap.hidden = retry.hidden = true;
    statusEl.textContent = 'اضغط «ابنِ الشجرة» لعرض العبارة الحالية.';
  };
  input.addEventListener('input', onEdit);
  input.addEventListener('search', onEdit);

  async function build(query: string, restoreFocus = false) {
    const terms = fold(query).text.split(' ').filter(Boolean);
    if (!terms.length) { clear(); return; }
    const request = ++generation;
    queryURL(query);
    tree.hidden = samplesWrap.hidden = retry.hidden = true;
    statusEl.textContent = 'جارٍ البناء…';
    try {
      const corpus = await loadCorpus();
      if (request !== generation) return;
      const before = new Map<string, number>();
      const after = new Map<string, number>();
      const hits = corpus.verses.filter((v) => {
        let found = false;
        for (let i = 0; i + terms.length <= v.words.length; i++) {
          if (!terms.every((t, k) => v.words[i + k] === t)) continue;
          found = true;
          if (i > 0) before.set(v.words[i - 1], (before.get(v.words[i - 1]) ?? 0) + 1);
          const next = v.words[i + terms.length];
          if (next) after.set(next, (after.get(next) ?? 0) + 1);
        }
        return found;
      });
      if (!hits.length) {
        statusEl.textContent = `لم ترد «${query}» بهذه الصورة كلمةً مستقلة. جرّب صورة أخرى (بـ«ال» أو بدونها).`;
        if (restoreFocus) input.focus();
        return;
      }
      statusEl.textContent = `«${query}»: وردت في ${arCount(hits.length, ['بيت واحد', 'بيتين', 'أبيات', 'بيتًا'])}.`;
      tree.hidden = samplesWrap.hidden = false;
      phraseEl.textContent = query;
      renderBranch(document.getElementById('before')!, before, (w) => `${corpus.spell(w)} ${query}`, corpus.spell);
      renderBranch(document.getElementById('after')!, after, (w) => `${query} ${corpus.spell(w)}`, corpus.spell);
      samplesEl.replaceChildren();
      paginate(samplesEl, hits, 30, (v) => {
        const p = corpus.poems[v.poem];
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/poem/${p[0]}/#v${v.n}`;
        const ranges = phraseRanges(v, terms);
        let offset = 0;
        const halves = v.text.split(' # ').map((half) => {
          const start = offset;
          offset += half.length + 3;
          const clipped: [number, number][] = ranges
            .filter(([s, e]) => s < start + half.length && e > start)
            .map(([s, e]) => [Math.max(0, s - start), Math.min(half.length, e - start)]);
          return `<span>${highlight(half, clipped)}</span>`;
        });
        a.innerHTML = `<span class="v">${halves.join('')}</span><small></small>`;
        a.querySelector('small')!.textContent = `«${p[1]}»، البيت ${digits.format(v.n)}`;
        li.append(a);
        return li;
      }, 'الأبيات');
      if (restoreFocus) phraseEl.focus();
    } catch {
      if (request !== generation) return;
      statusEl.textContent = 'تعذّر تحميل أبيات الديوان. تحقّق من الاتصال ثم أعد المحاولة؛ عبارتك محفوظة.';
      retry.hidden = false;
      if (restoreFocus) retry.focus();
    }
  }

  function paginate<T>(list: HTMLElement, items: T[], batch: number, item: (value: T) => HTMLElement, unit: string) {
    let shown = 0;
    const controls = document.createElement('li');
    controls.className = 'more-row';
    const label = document.createElement('p');
    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = 'عرض المزيد';
    controls.append(label, button);
    list.append(controls);
    const append = (focus = false) => {
      const rows = items.slice(shown, shown + batch).map(item);
      rows.forEach((row) => list.insertBefore(row, controls));
      shown += rows.length;
      label.textContent = `${unit}: المعروض ${digits.format(shown)} من ${digits.format(items.length)}`;
      button.hidden = shown >= items.length;
      if (focus) {
        rows[0]?.querySelector<HTMLElement>('button, a')?.focus();
        statusEl.textContent = label.textContent;
      }
    };
    button.addEventListener('click', () => append(true));
    append();
  }

  function renderBranch(list: HTMLElement, counts: Map<string, number>, next: (w: string) => string, spell: (w: string) => string) {
    list.replaceChildren();
    const sorted = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ar'));
    if (!sorted.length) { const li = document.createElement('li'); li.textContent = 'لا شيء'; list.append(li); return; }
    paginate(list, sorted, 14, ([word, n]) => {
      const li = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      const wordLabel = document.createElement('b');
      wordLabel.textContent = spell(word);
      const count = document.createElement('small');
      count.textContent = digits.format(n);
      button.append(wordLabel, count);
      button.setAttribute('aria-label', `مدّ العبارة: ${next(word)}، ${arCount(n, ['موضع واحد', 'موضعان', 'مواضع', 'موضعًا'])}`);
      button.addEventListener('click', () => { input.value = next(word); void build(input.value, true); });
      li.append(button);
      return li;
    }, 'الخيارات');
  }
  form.addEventListener('submit', (e) => { e.preventDefault(); void build(input.value.trim()); });
  retry.addEventListener('click', () => { void build(input.value.trim(), true); });
  const q = new URLSearchParams(location.search).get('q');
  if (q) { input.value = q; void build(q); }
</script>

<style>
  #phraseRetry[hidden], .branch :global(button[hidden]) { display: none; }
  .phrase-form {
    display: flex;
    gap: 8px;
    padding: 8px;
    padding-inline-start: 16px;
    margin-bottom: 8px;
  }
  .phrase-form:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .phrase-form input {
    flex: 1;
    min-width: 0;
    width: 100%;
    border: 0;
    background: none;
    font: 400 20px/1.8 var(--poem-font);
    color: var(--ink);
  }
  .phrase-form input:focus {
    outline: none;
  }
  .examples { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; color: var(--muted); font-size: var(--fs-sm); }
  .examples a { display: inline-flex; align-items: center; min-height: 44px; padding: 4px 10px; border-radius: 10px; background: var(--paper); border: 1px solid var(--glass-border); color: var(--ink); font-family: var(--poem-font); font-size: 20px; text-decoration: none; }
  .status:empty { display: none; }
  .status {
    color: var(--muted);
    font-size: var(--fs-sm);
    margin: 6px 4px 14px;
  }
  .tree {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto) minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }
  .tree[hidden],
  .samples[hidden] {
    display: none;
  }
  .phrase {
    min-width: 0;
    max-width: 28ch;
    overflow-wrap: anywhere;
    align-self: center;
    font-family: var(--poem-font);
    font-size: 34px;
    padding: 10px 18px;
    border-radius: 16px;
    background: var(--primary-bg);
    color: var(--primary-ink);
    text-align: center;
  }
  .branch {
    min-width: 0;
    padding: 12px 14px;
  }
  .branch h2 {
    font-size: 25px;
    margin: 0 0 6px;
  }
  .branch ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .branch :global(button) {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    border: 1px solid var(--line-dark);
    background: var(--paper-strong);
    color: var(--ink);
    border-radius: 10px;
    padding: 4px 10px;
    cursor: pointer;
    min-height: 44px;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .branch :global(button b) {
    font-family: var(--poem-font);
    font-weight: 400;
    font-size: 20px;
  }
  .branch :global(button small) {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .branch :global(.empty) {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .samples h2 {
    font-size: 29px;
    margin: 18px 0 8px;
  }
  .samples ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
    gap: 8px;
  }
  .samples :global(a) {
    display: grid;
    text-align: center;
    padding: 12px;
    border-radius: 14px;
    background: var(--paper);
    border: 1px solid var(--glass-border);
    color: var(--ink);
    text-decoration: none;
  }
  .samples :global(.v) {
    display: grid;
    font-family: var(--poem-font);
    font-size: 23px;
    line-height: 1.9;
  }
  .samples :global(small) {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .samples :global(mark) {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: inherit;
    border-radius: 4px;
  }
  .branch :global(.more-row), .samples :global(.more-row) { grid-column: 1 / -1; width: 100%; font-size: var(--fs-sm); color: var(--muted); }
  .branch :global(.more-row p), .samples :global(.more-row p) { margin: 8px 0; }
  .branch :global(.more-row button), .samples :global(.more-row button) { min-height: 44px; }
  .phrase:focus { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 760px) {
    .tree {
      grid-template-columns: 1fr;
    }
    .phrase {
      order: -1;
    }
  }
</style>
