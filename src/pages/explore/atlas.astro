---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import AtlasMap from '../../components/AtlasMap.astro';
import { SITE_NAME, ar } from '../../lib/diwan';
import { places, placeHref, KIND_LABELS } from '../../lib/atlas';
import { arCount } from '../../scripts/shared';

const groups = [
  { id: 'mapped', label: 'مواضع على الخريطة', places: places.filter((p) => p.lat !== undefined && p.lon !== undefined) },
  { id: 'unmapped', label: 'مواضع بلا إحداثيات', places: places.filter((p) => p.lat === undefined || p.lon === undefined) },
].map((group) => ({
  ...group,
  kinds: Object.entries(KIND_LABELS)
    .map(([kind, label]) => ({ kind, label, places: group.places.filter((p) => p.kind === kind) }))
    .filter((g) => g.places.length)
    .sort((a, b) => b.places.length - a.places.length),
}));

const title = `أطلس المواضع في شعر الشريف الرضي | ${SITE_NAME}`;
const description = `خريطة المواضع التي ذكرها الشريف الرضي في شعره: ${places
  .slice(0, 8)
  .map((p) => p.name)
  .join('، ')} وغيرها، مع الأبيات التي وردت فيها.`;
---

<Base title={title} description={description} section="atlas">
  <PageHead
    title="أطلس المواضع"
    parent={{ label: 'الفهارس', href: '/explore/' }}
  />

  <AtlasMap label="خريطة المواضع التي ذكرها الشريف الرضي في العراق والجزيرة العربية والشام" />


  {
    groups.map((group) => (
      <section class="place-group" id={group.id === 'mapped' ? 'places-list' : undefined} aria-labelledby={group.id}>
        <h2 id={group.id} class="group-heading">{group.label}</h2>
        {group.kinds.map((g) => (
          <section class="kind" aria-labelledby={`${group.id}-${g.kind}`}>
            <h3 id={`${group.id}-${g.kind}`}>
              {g.label} <small>{ar(g.places.length)}</small>
            </h3>
            <ul class="place-list">
              {g.places.map((p) => (
                <li>
                  <a href={placeHref(p)}>
                    <b>{p.name}</b>
                    <span>{p.verses.length
                      ? arCount(p.verses.length, ['شاهد واحد', 'شاهدان', 'شواهد', 'شاهدًا'])
                      : 'في الحواشي'}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </section>
    ))
  }
</Base>

<style>
  .place-group {
    scroll-margin-top: 90px;
  }
  .group-heading {
    font-size: 34px;
    margin: 20px 0 0;
  }
  .kind h3 {
    font-size: 24px;
    margin: 16px 0 6px;
  }
  .kind h3 small {
    font-family: var(--ui-font);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .place-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .place-list a {
    display: flex;
    flex-direction: column;
    padding: 6px 10px;
    min-height: 44px;
    overflow-wrap: anywhere;
    border-radius: 14px;
    background: var(--paper);
    border: 1px solid var(--glass-border);
    text-decoration: none;
    color: var(--ink);
    line-height: 1.35;
    height: 100%;
  }
  .place-list a:hover {
    background: var(--paper-strong);
  }
  .place-list b {
    font-family: var(--display-font);
    font-weight: 400;
    font-size: 25px;
  }
  .place-list span {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  @media (min-width: 700px) {
    .place-list { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  }
</style>
