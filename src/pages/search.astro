---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { poems, SITE_NAME } from '../lib/diwan';

const meters = [...new Set(poems.map((p) => p.meter))].sort((a, b) => a.localeCompare(b, 'ar'));
const rhymes = [...new Set(poems.map((p) => p.rhyme))];
---

<Base
  title={`البحث في الديوان | ${SITE_NAME}`}
  description="ابحث في أبيات ديوان الشريف الرضي وعناوين قصائده وحواشيه، بلفظة أو شطر، مع تقييد البحر والقافية."
  section="search"
>
  <PageHead title="البحث في الديوان" />

  <form class="search-box glass" id="searchForm" role="search" action="/search/" method="get">
    <div class="query-row">
      <label class="visually-hidden" for="q">لفظة أو شطر من بيت</label>
      <input id="q" name="q" type="search" placeholder="لفظة أو شطر من بيت" autocomplete="off" enterkeyhint="search" />
      <button class="btn query-action" id="optionsToggle" type="button" aria-label="خيارات البحث" title="خيارات البحث" aria-expanded="false" aria-controls="searchOptions">
        <svg class="ui-icon" aria-hidden="true"><use href="#i-sliders"></use></svg>
        <span class="option-marker" id="optionMarker" hidden aria-hidden="true"></span>
        <span class="visually-hidden" id="optionState"></span>
      </button>
      <button class="btn btn-primary query-action" type="submit" aria-label="ابحث" title="ابحث">
        <svg class="ui-icon" aria-hidden="true"><use href="#i-search"></use></svg>
      </button>
    </div>
    <div class="search-options" id="searchOptions" hidden>
      <div class="filters">
        <div class="segmented" role="radiogroup" aria-label="طريقة المطابقة">
          <label><input type="radio" name="mode" value="any" checked /> <span>كل الألفاظ</span></label>
          <label><input type="radio" name="mode" value="exact" /> <span>العبارة كما هي</span></label>
        </div>
        <label class="field">
          <span>مجال البحث</span>
          <select name="in">
            <option value="verses">الأبيات</option>
            <option value="titles">عناوين القصائد</option>
            <option value="notes">الحواشي والشروح</option>
            <option value="intros">أخبار القصائد</option>
          </select>
        </label>
        <label class="field">
          <span>البحر</span>
          <select name="meter">
            <option value="">البحور كلها</option>
            {meters.map((m) => <option value={m}>{m}</option>)}
          </select>
        </label>
        <label class="field">
          <span>القافية</span>
          <select name="rhyme">
            <option value="">القوافي كلها</option>
            {rhymes.map((r) => <option value={r}>{r}</option>)}
          </select>
        </label>
        <label class="field">
          <span>الجزء</span>
          <select name="vol">
            <option value="">الجزآن</option>
            <option value="1">الأول</option>
            <option value="2">الثاني</option>
          </select>
        </label>
      </div>
    </div>
  </form>

  <div class="filter-restrictions" id="searchRestrictions" hidden>
    <span id="searchRestrictionText"></span>
    <button class="btn" type="button" id="clearRestrictions">إزالة القيود</button>
  </div>
  <div class="status" id="searchStatus" role="status" aria-live="polite"></div>
  <button class="btn" id="retrySearch" type="button" hidden>إعادة المحاولة</button>
  <ol class="results" id="results"></ol>
  <button class="btn more" id="more" type="button" hidden>عرض المزيد</button>

  <section class="tips glass" id="tips">
    <h2>أمثلة</h2>
    <ul>
      <li><a href="/search/?q=الزمان">الزمان</a></li>
      <li><a href="/search/?q=الشيب">الشيب</a></li>
      <li><a href="/search/?q=بغداد">بغداد</a></li>
      <li><a href="/search/?q=الحسين">الحسين</a></li>
      <li><a href="/search/?q=ليهنك+اليوم&mode=exact">ليهنك اليوم</a></li>
    </ul>
  </section>

  <noscript><p class="status">البحث يحتاج إلى تفعيل JavaScript. يمكنك تصفح <a href="/diwan/">فهرس القصائد</a>.</p></noscript>
</Base>

<script>
  import { fold, queryTerms, findAll, highlight } from '../scripts/arabic-search';
  import { arCount } from '../scripts/shared';
  import type { Folded } from '../scripts/arabic-search';

  type PoemRow = [id: string, title: string, meter: string, rhyme: string, volume: number];
  type Entry = [poem: number, n: number, text: string];
  interface Indexed {
    entry: Entry;
    folded?: Folded;
  }

  const form = document.getElementById('searchForm') as HTMLFormElement;
  const input = document.getElementById('q') as HTMLInputElement;
  const statusEl = document.getElementById('searchStatus')!;
  const results = document.getElementById('results')!;
  const more = document.getElementById('more') as HTMLButtonElement;
  const tips = document.getElementById('tips')!;
  const retry = document.getElementById('retrySearch') as HTMLButtonElement;
  const restrictions = document.getElementById('searchRestrictions')!;
  const restrictionText = document.getElementById('searchRestrictionText')!;
  const options = document.getElementById('searchOptions')!;
  const optionsToggle = document.getElementById('optionsToggle') as HTMLButtonElement;
  const optionMarker = document.getElementById('optionMarker')!;
  const optionState = document.getElementById('optionState')!;
  optionsToggle.setAttribute('aria-describedby', 'optionState');
  optionsToggle.addEventListener('click', () => {
    options.hidden = !options.hidden;
    optionsToggle.setAttribute('aria-expanded', String(!options.hidden));
  });
  options.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    event.preventDefault();
    options.hidden = true;
    optionsToggle.setAttribute('aria-expanded', 'false');
    optionsToggle.focus({ preventScroll: true });
  });
  const digits = new Intl.NumberFormat('ar-EG');
  const PAGE = 40;

  let poems: PoemRow[] = [];
  const fields: Record<string, Indexed[]> = {};
  let mainLoad: Promise<void> | null = null;
  let notesLoad: Promise<void> | null = null;

  function loadMain() {
    mainLoad ??= fetch('/search-index.json')
      .then((r) => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.json();
      })
      .then((data: { poems: PoemRow[]; verses: Entry[] }) => {
        poems = data.poems;
        fields.verses = data.verses.map((entry) => ({ entry }));
        fields.titles = data.poems.map((p, i) => ({ entry: [i, 0, p[1]] as Entry }));
      })
      .catch((error) => { mainLoad = null; throw error; });
    return mainLoad;
  }
  function loadNotes() {
    notesLoad ??= fetch('/search-notes.json')
      .then((r) => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.json();
      })
      .then((data: { notes: Entry[]; intros: Entry[] }) => {
        fields.notes = data.notes.map((entry) => ({ entry }));
        fields.intros = data.intros.map((entry) => ({ entry }));
      })
      .catch((error) => { notesLoad = null; throw error; });
    return notesLoad;
  }

  // Start downloading as soon as the visitor shows intent.
  input.addEventListener('focus', () => { void loadMain().catch(() => {}); }, { once: true });

  let matches: { item: Indexed; ranges: [number, number][] }[] = [];
  let shown = 0;
  // Appended results always use the state that produced their matches.
  let completed: ReturnType<typeof read> | null = null;

  function read() {
    const fd = new FormData(form);
    return {
      q: String(fd.get('q') ?? '').trim(),
      mode: String(fd.get('mode') ?? 'any'),
      field: String(fd.get('in') ?? 'verses'),
      meter: String(fd.get('meter') ?? ''),
      rhyme: String(fd.get('rhyme') ?? ''),
      vol: String(fd.get('vol') ?? ''),
    };
  }

  function writeUrl(s: ReturnType<typeof read>) {
    const params = new URLSearchParams();
    if (s.q) params.set('q', s.q);
    if (s.mode !== 'any') params.set('mode', s.mode);
    if (s.field !== 'verses') params.set('in', s.field);
    if (s.meter) params.set('meter', s.meter);
    if (s.rhyme) params.set('rhyme', s.rhyme);
    if (s.vol) params.set('vol', s.vol);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  const fieldLabels: Record<string, string> = {
    verses: 'الأبيات', titles: 'عناوين القصائد', notes: 'الحواشي والشروح', intros: 'أخبار القصائد',
  };
  function updateOptions() {
    const s = read();
    const labels = [
      s.mode !== 'any' && 'العبارة كما هي',
      s.field !== 'verses' && `المجال: ${fieldLabels[s.field]}`,
      s.meter && `البحر: ${s.meter}`,
      s.rhyme && `القافية: ${s.rhyme}`,
      s.vol && `الجزء ${s.vol === '1' ? 'الأول' : 'الثاني'}`,
    ].filter(Boolean);
    optionMarker.hidden = !labels.length;
    optionState.textContent = labels.length ? 'خيارات مفعّلة' : '';
    restrictionText.textContent = `القيود: ${labels.join('، ')}`;
    restrictions.hidden = !labels.length;
  }

  let runId = 0;
  function invalidate() {
    ++runId;
    completed = null;
    matches = [];
    shown = 0;
    results.replaceChildren();
    more.disabled = true;
    more.hidden = true;
    retry.hidden = true;
    results.setAttribute('aria-busy', 'false');
  }
  async function run() {
    window.clearTimeout(typingTimer);
    invalidate();
    const id = runId;
    const s = read();
    updateOptions();
    writeUrl(s);
    const terms = queryTerms(s.q, s.mode === 'exact');
    if (!terms.length) {
      tips.hidden = false;
      statusEl.textContent = '';
      return;
    }
    tips.hidden = true;
    results.setAttribute('aria-busy', 'true');
    statusEl.textContent = `جارٍ البحث عن «${s.q}» في ${fieldLabels[s.field]}…`;
    try {
      await loadMain();
      if (id !== runId) return;
      if (s.field === 'notes' || s.field === 'intros') await loadNotes();
    } catch {
      if (id !== runId) return;
      results.setAttribute('aria-busy', 'false');
      statusEl.textContent = 'تعذّر تحميل بيانات البحث. تحقّق من الاتصال ثم أعد المحاولة؛ تبقى عبارتك وخياراتك محفوظة هنا.';
      retry.hidden = false;
      return;
    }
    if (id !== runId) return;

    matches = [];
    for (const item of fields[s.field] ?? []) {
      const p = poems[item.entry[0]];
      if (s.meter && p[2] !== s.meter) continue;
      if (s.rhyme && p[3] !== s.rhyme) continue;
      if (s.vol && String(p[4]) !== s.vol) continue;
      item.folded ??= fold(item.entry[2]);
      const ranges = findAll(item.folded, terms);
      if (ranges) matches.push({ item, ranges });
    }
    completed = s;
    results.setAttribute('aria-busy', 'false');
    more.disabled = false;
    renderMore();
    const poemsHit = new Set(matches.map((m) => m.item.entry[0])).size;
    statusEl.textContent = matches.length
      ? `${arCount(matches.length, ['نتيجة واحدة', 'نتيجتان', 'نتائج', 'نتيجة'])} في ${arCount(poemsHit, ['قصيدة واحدة', 'قصيدتين', 'قصائد', 'قصيدة'])}، عن «${s.q}» في ${fieldLabels[s.field]}`
      : 'لا نتائج. جرّب لفظة أقصر، أو «كل الألفاظ»، أو أزل قيود البحر والقافية.';
  }

  function renderMore(moveFocus = false) {
    if (!completed || more.disabled) return;
    const field = completed.field;
    let firstNewLink: HTMLAnchorElement | undefined;
    const frag = document.createDocumentFragment();
    for (const { item, ranges } of matches.slice(shown, shown + PAGE)) {
      const [pi, n, text] = item.entry;
      const p = poems[pi];
      const li = document.createElement('li');
      li.className = 'result glass';
      const a = document.createElement('a');
      a.href = `/poem/${p[0]}/${n ? `#v${n}` : ''}`;
      firstNewLink ??= a;
      const body = document.createElement('div');
      body.className = field === 'verses' ? 'result-verse' : field === 'titles' ? 'result-title' : 'result-note';
      if (field === 'verses') {
        // Highlight each half separately so the two halves can be laid out on their own lines.
        const split = text.indexOf(' # ');
        const halves = split < 0 ? [text] : [text.slice(0, split), text.slice(split + 3)];
        let offset = 0;
        body.innerHTML = halves
          .map((half) => {
            const local = ranges
              .map(([s, e]) => [s - offset, e - offset] as [number, number])
              .filter(([s, e]) => e > 0 && s < half.length)
              .map(([s, e]) => [Math.max(0, s), Math.min(half.length, e)] as [number, number]);
            offset += half.length + 3;
            return `<span>${highlight(half, local)}</span>`;
          })
          .join('');
      } else {
        body.innerHTML = highlight(text, ranges);
      }
      const meta = document.createElement('div');
      meta.className = 'result-meta';
      meta.textContent = `${p[1]}، ${p[2]}${n ? `، البيت ${digits.format(n)}` : ''}`;
      a.append(body, meta);
      li.append(a);
      frag.append(li);
    }
    results.append(frag);
    if (moveFocus) firstNewLink?.focus();
    shown = Math.min(matches.length, shown + PAGE);
    more.hidden = shown >= matches.length;
    if (!more.hidden) more.textContent = `عرض المزيد (${digits.format(matches.length - shown)} متبقية)`;
  }

  let typingTimer: number | undefined;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    window.clearTimeout(typingTimer);
    void run();
  });
  input.addEventListener('input', () => {
    window.clearTimeout(typingTimer);
    // Invalidate immediately, including the debounce window and native search-clear button.
    invalidate();
    updateOptions();
    writeUrl(read());
    if (!queryTerms(input.value, read().mode === 'exact').length) {
      void run();
      return;
    }
    tips.hidden = true;
    results.setAttribute('aria-busy', 'true');
    statusEl.textContent = 'جارٍ إعداد البحث…';
    typingTimer = window.setTimeout(() => { void run(); }, 250);
  });
  form.addEventListener('change', (e) => {
    if ((e.target as HTMLElement) !== input) void run();
  });
  more.addEventListener('click', () => renderMore(true));
  retry.addEventListener('click', () => { void run(); input.focus(); });
  document.getElementById('clearRestrictions')!.addEventListener('click', () => {
    const q = input.value;
    form.reset();
    input.value = q;
    void run();
    input.focus();
  });

  // Restore a search from the URL (shared links, back button).
  const params = new URLSearchParams(location.search);
  if (params.size) {
    input.value = params.get('q') ?? '';
    for (const name of ['mode', 'in', 'meter', 'rhyme', 'vol']) {
      const value = params.get(name);
      if (!value) continue;
      const el = form.elements.namedItem(name);
      if (el instanceof RadioNodeList) el.value = value;
      else if (el instanceof HTMLSelectElement && [...el.options].some((option) => option.value === value)) el.value = value;
    }
    run();
  }
  updateOptions();
</script>

<style>
  .search-box {
    padding: 8px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    margin-bottom: 14px;
  }
  .query-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px 44px;
    align-items: center;
    gap: 4px;
  }
  .query-row input {
    min-width: 0;
    width: 100%;
    min-height: 52px;
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    background: var(--paper-strong);
    font: 400 var(--fs-md)/2 var(--poem-font);
    color: var(--ink);
    padding: 6px 10px;
  }
  .query-row input::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  .query-row input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .query-action {
    position: relative;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
  }
  .option-marker {
    position: absolute;
    inset-block-start: 5px;
    inset-inline-end: 5px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 2px var(--paper-strong);
  }
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .search-options {
    min-width: 0;
    padding: 0 4px 4px;
    overflow-anchor: none;
  }
  .search-options[hidden], .option-marker[hidden] {
    display: none;
  }
  .segmented {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-column: 1 / -1;
    background: var(--chip-bg);
    border-radius: 12px;
    padding: 3px;
  }
  .segmented label {
    position: relative;
    min-width: 0;
  }
  .segmented input {
    position: absolute;
    opacity: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .segmented span {
    display: block;
    min-height: 44px;
    align-content: center;
    padding: 7px 6px;
    text-align: center;
    border-radius: 9px;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .segmented input:checked + span {
    background: var(--paper-strong);
    color: var(--ink);
    box-shadow: var(--glass-shadow-soft);
  }
  .segmented input:focus-visible + span {
    outline: 2px solid var(--accent);
  }
  .field {
    display: grid;
    min-width: 0;
    gap: 2px;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .field select {
    width: 100%;
    min-width: 0;
    font: 400 var(--fs-sm)/1.6 var(--ui-font);
    color: var(--ink);
    background: var(--paper-strong);
    border: 1px solid var(--line-dark);
    border-radius: 10px;
    padding: 8px 12px;
    min-height: 48px;
  }
  .status {
    color: var(--muted);
    font-size: var(--fs-sm);
    margin: 6px 4px 12px;
  }
  .results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .results :global(.result a) {
    display: block;
    scroll-margin-block: 80px;
    padding: 14px 18px;
    color: var(--ink);
    text-decoration: none;
  }
  .results :global(.result:hover) {
    background: var(--paper-strong);
  }
  .results :global(.result-verse) {
    font-family: var(--poem-font);
    font-size: 25px;
    line-height: 1.9;
    text-align: center;
    display: grid;
  }
  .results :global(.result-title) {
    font-family: var(--display-font);
    font-size: 30px;
  }
  .results :global(.result-note) {
    font-family: var(--poem-font);
    font-size: 21px;
    line-height: 1.9;
  }
  .results :global(mark) {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: inherit;
    border-radius: 4px;
    padding: 0 2px;
  }
  .results :global(.result-meta) {
    font-size: var(--fs-xs);
    color: var(--muted);
    margin-top: 4px;
  }
  .more {
    display: flex;
    margin: 14px auto 0;
  }
  #retrySearch[hidden],
  .more[hidden] {
    display: none;
  }
  .tips {
    padding: 16px 20px;
  }
  .tips[hidden] {
    display: none;
  }
  .tips h2 {
    font-size: 25px;
    margin: 0 0 6px;
  }
  .tips ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
  }
  .tips a {
    display: inline-block;
    font-family: var(--poem-font);
    font-size: 21px;
    padding: 4px 14px;
    border-radius: 10px;
    background: var(--chip-bg);
    text-decoration: none;
  }
  @media (min-width: 700px) {
    .search-box { padding: 14px; }
    .query-row { gap: 8px; }
    .filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
