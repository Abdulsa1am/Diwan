---
import Base from '../../layouts/Base.astro';
import { poems, ar, versesLabel, verseText, POET, SITE_NAME } from '../../lib/diwan';
import type { Poem } from '../../lib/diwan';
import { wordsByVerse, wordHref } from '../../lib/lexicon';

export function getStaticPaths() {
  return poems.map((poem, i) => ({
    params: { id: poem.id },
    props: { poem, prev: poems[i - 1], next: poems[i + 1] },
  }));
}

interface Props {
  poem: Poem;
  prev?: Poem;
  next?: Poem;
}

const { poem, prev, next } = Astro.props;
const count = poem.verses.length;
const opening = poem.verses[0];
const annotatedCount = poem.verses.filter((v) => v.notes.length > 0 || wordsByVerse.has(`${poem.id}#${v.n}`)).length;

// The opening half-line makes every title unique (seven headings repeat in the diwan) and matches line searches.
const title = `${poem.title}: «${opening.sadr.replace(/[،,.:؛]+$/, '')}» | ${POET}`;
const description = `قصيدة للشريف الرضي من بحر ${poem.meter}، قافية ${poem.rhyme}، ${versesLabel(count)}. مطلعها: ${verseText(opening)}`;
const url = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL('/', Astro.site).href;
const pages = poem.endPage !== poem.startPage ? `${ar(poem.startPage)}–${ar(poem.endPage)}` : ar(poem.startPage);
const citation = `الشريف الرضي، «${poem.title}»، ديوان الشريف الرضي، ج${ar(poem.volume)}، ص${pages}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      '@id': url,
      url,
      name: poem.title,
      genre: 'شعر',
      inLanguage: 'ar',
      author: { '@type': 'Person', name: POET, sameAs: 'https://ar.wikipedia.org/wiki/الشريف_الرضي' },
      isPartOf: { '@type': 'Book', name: SITE_NAME, url: home },
      abstract: verseText(opening),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: home },
        { '@type': 'ListItem', position: 2, name: 'الديوان', item: new URL('/diwan/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: poem.title, item: url },
      ],
    },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd} type="article" section="library" reading={{ title: poem.title, total: count }}>
  <article
    class="reader"
    data-poem={poem.id}
    data-title={poem.title}
    data-first={opening.sadr}
    data-citation={citation}
  >
    <a class="back" href="/diwan/">
      <svg class="ui-icon" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
      العودة إلى الديوان
    </a>

    <header class="reader-head" id="readerHead">
      <h1>{poem.title}</h1>
      <div class="meta">
        <span class="chip">{poem.meter}</span>
        <span class="chip">روي {poem.rhyme}</span>
        <span class="chip">{versesLabel(count)}</span>
        <span class="chip">الجزء {ar(poem.volume)}</span>
        <span class="chip">ص {pages}</span>
        {poem.linkedNoteCount > 0 && <span class="chip">شروح الأبيات {ar(poem.linkedNoteCount)}</span>}
        {poem.notes.length > 0 && <a class="chip residual-shortcut" href="#residualNotes">{poem.linkedNoteCount > 0 ? 'حواشٍ أخرى' : 'الحواشي'} ({ar(poem.notes.length)})</a>}
      </div>
      <div class="poem-actions" role="toolbar" aria-label="أدوات القصيدة">
        <button class="btn" type="button" data-action="save" aria-pressed="false" aria-label="حفظ القصيدة في محفوظاتي">
          <svg class="ui-icon" aria-hidden="true"><use href="#i-bookmark"></use></svg>
          <span data-save-label>احفظ</span>
        </button>
        <button class="btn" type="button" data-action="copy-poem" aria-label="نسخ القصيدة">
          <svg class="ui-icon" aria-hidden="true"><use href="#i-copy"></use></svg>
          <span class="action-label">انسخ</span>
        </button>
        <button class="btn" type="button" data-action="share" aria-label="مشاركة القصيدة">
          <svg class="ui-icon" aria-hidden="true"><use href="#i-share"></use></svg>
          <span class="action-label">شارك</span>
        </button>
        <button class="btn" type="button" data-action="settings" aria-label="صفة القراءة" aria-expanded="false" aria-controls="readerSettings">
          <svg class="ui-icon" aria-hidden="true"><use href="#i-sliders"></use></svg>
          <span class="action-label">صفة القراءة</span>
        </button>
        {annotatedCount > 0 && (
          <button class="btn" type="button" data-action="notes" aria-label={`الشروح (${ar(annotatedCount)})`} aria-pressed="false" aria-controls="poemSheet">
            الشروح<span class="annotation-count"> ({ar(annotatedCount)})</span>
          </button>
        )}
      </div>
      <div class="reader-settings glass" id="readerSettings" hidden>
        <div class="setting">
          <span id="sizeLabel">حجم الخط</span>
          <div class="stepper" role="group" aria-labelledby="sizeLabel">
            <button class="btn" type="button" data-size="-1" aria-label="تصغير الخط">أ−</button>
            <output data-size-value>١٠٠٪</output>
            <button class="btn" type="button" data-size="1" aria-label="تكبير الخط">أ+</button>
          </div>
        </div>
        <div class="setting">
          <span id="layoutLabel">ترتيب الشطرين</span>
          <div class="segmented" role="radiogroup" aria-labelledby="layoutLabel">
            <button type="button" role="radio" data-layout="auto" aria-checked="true">تلقائي</button>
            <button type="button" role="radio" data-layout="side" aria-checked="false">متجاوران</button>
            <button type="button" role="radio" data-layout="stacked" aria-checked="false">متتابعان</button>
          </div>
        </div>
      </div>
    </header>

    {
      (poem.intro || poem.introGlosses) && (
        <details class="intro glass">
          <summary>خبر القصيدة</summary>
          {poem.intro && <p>{poem.intro}</p>}
          {poem.introGlosses && (
            <p class="intro-glosses">
              <b>شروح وردت مع الخبر:</b> {poem.introGlosses}
            </p>
          )}
        </details>
      )
    }

    {
      poem.quotation && (
        <figure class="quotation glass">
          <blockquote>
            {poem.quotation.lines.map((line) => (
              <p>{line}</p>
            ))}
          </blockquote>
          <figcaption>القائل: {poem.quotation.attribution}. وليس هذا من شعر الرضي.</figcaption>
        </figure>
      )
    }

    <ol class="poem-sheet" id="poemSheet">
      {
        poem.verses.map((v) => (
          <li
            class:list={['verse', { single: !v.ajuz }]}
            id={`v${v.n}`}
            data-n={v.n}
            data-annotated={v.notes.length > 0 || wordsByVerse.has(`${poem.id}#${v.n}`) ? '' : undefined}
          >
            <a class="verse-no" href={`#v${v.n}`} aria-haspopup="menu" aria-label={`البيت ${ar(v.n)}: أدوات البيت`}>
              {ar(v.n)}
            </a>
            <div class="verse-body">
              <span class="hemistich sadr">{v.sadr}</span>
              {v.ajuz && <span class="hemistich ajuz">{v.ajuz}</span>}
            </div>
            {wordsByVerse.has(`${poem.id}#${v.n}`) && (
              <p class="verse-words">
                في المعجم:{' '}
                {wordsByVerse.get(`${poem.id}#${v.n}`)!.map((w, i) => (
                  <>
                    {i > 0 && '، '}
                    <a href={wordHref(w)}>{w}</a>
                  </>
                ))}
              </p>
            )}
            {v.notes.length > 0 && (
              <details class="verse-notes">
                <summary>شرح{v.notes.length > 1 && ` (${ar(v.notes.length)})`}</summary>
                {v.notes.map((note) => (
                  <p>{note}</p>
                ))}
              </details>
            )}
          </li>
        ))
      }
    </ol>

    {
      poem.notes.length > 0 && (
        <details class="notes glass" id="residualNotes">
          <summary>{poem.linkedNoteCount > 0 ? 'حواشٍ أخرى' : 'الحواشي'} ({ar(poem.notes.length)})</summary>
          <ul>
            {poem.notes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </details>
      )
    }

    <nav class="poem-nav" aria-label="التنقل بين القصائد">
      {
        prev ? (
          <a class="glass" href={`/poem/${prev.id}/`} rel="prev">
            <svg class="ui-icon" aria-hidden="true"><use href="#i-chevron-right" /></svg>
            <span>
              <small>القصيدة السابقة</small>
              {prev.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="glass next" href={`/poem/${next.id}/`} rel="next">
            <span>
              <small>القصيدة التالية</small>
              {next.title}
            </span>
            <svg class="ui-icon" aria-hidden="true"><use href="#i-chevron-left" /></svg>
          </a>
        )
      }
    </nav>
  </article>

  <div class="verse-menu glass" id="verseMenu" role="menu" aria-labelledby="verseMenuTitle" hidden>
    <b class="verse-menu-title" id="verseMenuTitle" data-menu-title></b>
    <button type="button" role="menuitem" data-verse-action="notes" hidden>شرح البيت</button>
    <button type="button" role="menuitem" data-verse-action="copy">نسخ البيت</button>
    <button type="button" role="menuitem" data-verse-action="cite">نسخ البيت مع الإحالة</button>
    <button type="button" role="menuitem" data-verse-action="link">نسخ رابط البيت</button>
    <button type="button" role="menuitem" data-verse-action="share">مشاركة البيت</button>
  </div>
</Base>

<script>
  import '../../scripts/reader';
</script>

<style>
  .reader {
    max-width: 860px;
    margin: 0 auto;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    min-height: 40px;
  }
  .back:hover {
    color: var(--accent);
  }

  .reader-head {
    text-align: center;
    padding: 8px 0 18px;
  }
  h1 {
    font-size: clamp(38px, 6vw, 52px);
    margin: 2px 0 8px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .residual-shortcut {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .poem-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
  }
  .poem-actions .btn {
    padding: 7px 14px;
    min-height: 44px;
  }
  .poem-actions .ui-icon {
    width: 18px;
    height: 18px;
  }
  .poem-actions [aria-pressed='true'] {
    background: var(--primary-bg);
    color: var(--primary-ink);
  }
  .poem-actions [aria-pressed='true'] .ui-icon {
    fill: currentColor;
  }

  .reader-settings[hidden] {
    display: none;
  }
  .reader-settings {
    margin: 12px auto 0;
    max-width: 460px;
    padding: 14px 18px;
    display: grid;
    gap: 12px;
    text-align: start;
  }
  .setting {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
  }
  .stepper {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .stepper .btn {
    min-width: 44px;
    justify-content: center;
    padding: 6px 10px;
  }
  .stepper output {
    min-width: 48px;
    text-align: center;
  }
  .segmented {
    display: flex;
    background: var(--chip-bg);
    border-radius: 12px;
    padding: 3px;
  }
  .segmented button {
    border: 0;
    background: none;
    color: var(--muted);
    font: 500 13px/1.6 var(--ui-font);
    padding: 6px 10px;
    border-radius: 9px;
    cursor: pointer;
    min-height: 36px;
  }
  .segmented [aria-checked='true'] {
    background: var(--paper-strong);
    color: var(--ink);
    box-shadow: var(--glass-shadow-soft);
  }

  .intro {
    margin-bottom: 16px;
    padding: 2px 20px;
  }
  .intro summary {
    cursor: pointer;
    font-family: var(--display-font);
    font-size: 22px;
    color: var(--accent);
    padding: 8px 0;
  }
  .intro p {
    font-family: var(--poem-font);
    font-size: 19px;
    line-height: 2;
    margin: 0 0 12px;
  }
  .intro .intro-glosses {
    font-size: 16px;
    color: var(--muted);
  }
  .intro-glosses b {
    font-family: var(--ui-font);
    font-size: 13px;
    font-weight: 500;
  }

  .quotation {
    margin: 0 0 16px;
    padding: 18px 22px;
    text-align: center;
    color: var(--muted);
  }
  .quotation blockquote {
    margin: 0;
    font-family: var(--poem-font);
    font-size: 22px;
    line-height: 2;
  }
  .quotation p {
    margin: 0;
  }
  .quotation figcaption {
    font-size: 13px;
    margin-top: 6px;
  }

  /* The poem sheet: big glass card, Amiri verses, small verse numbers at the start corner. */
  .poem-sheet {
    --poem-design-size: calc(clamp(21px, 5.6vw, 30px) * var(--poem-scale, 1));
    --verse-floor: 20px;
    --verse-columns: 1;
    --verse-gap: 28px;
    /* An unfitted reference size for JS, independent of the fitted hemistichs. */
    font-size: var(--poem-design-size);
    list-style: none;
    margin: 0 0 16px;
    padding: 16px clamp(6px, 3vw, 28px);
    background: var(--paper-strong);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    box-shadow: var(--glass-shadow-soft), var(--glass-inset);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
  }
  .verse {
    position: relative;
    padding: 16px 8px 12px;
    scroll-margin-top: 120px;
  }
  .verse + .verse {
    border-top: 1px solid var(--line-dark);
  }
  .verse:target,
  .verse.is-active {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .verse-no {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0 6px;
    display: grid;
    place-items: center;
    border-radius: 4px;
    background: var(--paper-strong);
    font-size: 13px;
    line-height: 1.4;
    color: var(--muted);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .verse-no:hover {
    background: var(--chip-bg);
    color: var(--accent);
  }
  .verse-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    text-align: center;
  }
  .hemistich {
    min-width: 0;
    font-family: var(--poem-font);
    font-size: var(--poem-design-size);
    white-space: normal;
    text-wrap: balance;
    overflow-wrap: normal;
    line-height: 1.95;
    color: var(--ink);
    font-feature-settings: 'kern', 'liga', 'calt', 'mark', 'mkmk';
  }

  /* Without JS these layouts can wrap. Fitting may switch just this poem to stacked. */
  @media (min-width: 1180px) {
    :global(html:not([data-verse-layout='stacked'])) .poem-sheet {
      --verse-columns: 2;
      --verse-gap: 32px;
    }
  }
  :global(html[data-verse-layout='side']) .poem-sheet {
    --verse-columns: 2;
    --verse-gap: 28px;
  }
  @media (min-width: 700px) {
    .poem-sheet {
      --verse-floor: 22px;
    }
  }
  /* Very small phones (320–360px): a slightly smaller floor keeps each half-verse on one line. */
  @media (max-width: 360px) {
    .poem-sheet {
      --verse-floor: 18px;
    }
  }
  .verse-body {
    grid-template-columns: repeat(var(--verse-columns), minmax(0, 1fr));
    column-gap: var(--verse-gap);
  }
  .poem-sheet[data-fitted-layout='stacked'] .verse-body {
    grid-template-columns: minmax(0, 1fr);
  }
  .single .verse-body {
    grid-template-columns: minmax(0, 1fr) !important;
  }
  .poem-sheet.is-fitted .hemistich {
    font-size: var(--poem-fitted-size);
    white-space: nowrap;
    text-wrap: nowrap;
  }
  .poem-sheet.is-fitted .hemistich.can-wrap {
    white-space: normal;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .reader:not(.show-annotations) .verse:not(.annotations-revealed) .verse-words,
  .reader:not(.show-annotations) .verse:not(.annotations-revealed) .verse-notes {
    display: none;
  }

  .verse-words {
    margin: 2px 0 0;
    text-align: center;
    font-size: 13px;
    color: var(--muted);
  }
  .verse-notes {
    margin: 4px auto 0;
    max-width: 640px;
    text-align: start;
  }
  .verse-notes summary {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 2px 12px;
    border-radius: 8px;
    border: 1px solid var(--line-dark);
    background: var(--paper);
    font-size: 13px;
    color: var(--accent-deep);
    cursor: pointer;
    list-style: none;
  }
  .verse-notes summary::-webkit-details-marker {
    display: none;
  }
  .verse-notes[open] summary {
    background: var(--chip-bg);
  }
  .verse-notes p {
    font-family: var(--poem-font);
    font-size: 17px;
    line-height: 1.9;
    color: var(--muted);
    margin: 8px 0 0;
  }

  .notes {
    scroll-margin-top: 120px;
    padding: 16px 22px;
    margin-bottom: 16px;
  }
  .notes summary {
    cursor: pointer;
    font-family: var(--display-font);
    font-size: 24px;
  }
  .notes[open] summary {
    margin-bottom: 6px;
  }
  .notes ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--poem-font);
    font-size: 17px;
    line-height: 1.9;
    color: var(--muted);
  }
  .notes li + li {
    margin-top: 6px;
  }

  .poem-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .poem-nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--display-font);
    font-size: 22px;
    line-height: 1.4;
  }
  .poem-nav a .ui-icon {
    color: var(--accent);
  }
  .poem-nav .next {
    justify-content: flex-end;
    text-align: end;
  }
  .poem-nav small {
    display: block;
    font-family: var(--ui-font);
    font-size: 13px;
    color: var(--muted);
  }
  .poem-nav a:hover {
    background: var(--paper-strong);
  }

  .verse-menu {
    position: fixed;
    z-index: 30;
    display: grid;
    width: max-content;
    min-width: min(210px, calc(100vw - 16px));
    max-width: calc(100vw - 16px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px;
    background: var(--menu-bg);
    box-shadow: var(--glass-shadow);
  }
  .verse-menu[hidden] {
    display: none;
  }
  .verse-menu-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    padding: 4px 10px 6px;
  }
  .verse-menu button {
    border: 0;
    background: none;
    text-align: start;
    font: 500 14px/1.6 var(--ui-font);
    color: var(--ink);
    padding: 9px 10px;
    border-radius: 9px;
    cursor: pointer;
  }
  .verse-menu button:hover,
  .verse-menu button:focus-visible {
    background: var(--chip-bg);
  }

  @media (max-width: 620px) {
    .verse {
      padding-inline: 4px;
    }
    .poem-actions {
      flex-wrap: nowrap;
      gap: 4px;
    }
    .poem-actions .btn {
      font-size: 13px;
      padding: 6px 8px;
      gap: 5px;
      flex-shrink: 0;
      white-space: nowrap;
    }
    .poem-actions .action-label, .poem-actions .annotation-count { display: none; }
    .poem-actions [data-action='copy-poem'],
    .poem-actions [data-action='share'],
    .poem-actions [data-action='settings'] {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
    .poem-nav a {
      font-size: 18px;
    }
  }
</style>
