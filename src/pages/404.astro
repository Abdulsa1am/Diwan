---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { SITE_NAME } from '../lib/diwan';
---

<Base title={`الصفحة غير موجودة | ${SITE_NAME}`} description="الرابط المطلوب غير موجود في الديوان.">
  <section class="missing glass">
    <PageHead title="هذه الصفحة غير موجودة" />
    <a class="btn btn-primary" href="/diwan/">افتح الديوان</a>
  </section>
</Base>

<style>
  .missing {
    text-align: center;
    padding: 48px 24px;
    max-width: 560px;
    margin: 24px auto;
  }
</style>
